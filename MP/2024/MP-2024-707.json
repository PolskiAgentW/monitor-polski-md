   "children": []
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Waszkiewicz-Bolanowska Monika Magda, na wniosek Ministra Spraw Zagranicznych",
   "children": [
    {
     "type": "text",
     "text": "obywatel Królestwa Szwecji"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi we wspieraniu przemian demokratycznych w Polsce"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
