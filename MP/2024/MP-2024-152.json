   "children": []
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Senkowski Andrzej Juliusz, za zasługi w działalności na rzecz przemian demokratycznych w Polsce",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
