{
 "eli": "MP/2024/953",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 19 września 2024 r. nr rej. 476/2024 o nadaniu orderu i odznaczeń",
 "converter": "eli2md 0.6.25.2",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2024/953/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 19 września 2024 r."
  },
  {
   "type": "text",
   "text": "nr rej. 476/2024"
  },
  {
   "type": "text",
   "text": "o nadaniu orderu i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2023 r. poz. 2053) odznaczeni zostają obywatele Rzeczypospolitej Polskiej zamieszkali w Stanach Zjednoczonych Ameryki oraz obywatele Stanów Zjednoczonych Ameryki:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w upowszechnianiu wiedzy o historii Polski"
  },
  {
   "type": "text",
   "text": "KRZYŻEM OFICERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Rawicz Andrew Peter,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz środowisk polonijnych w Stanach Zjednoczonych Ameryki:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Marciniak Piotr Krzysztof o. Bartłomiej,",
   "children": []
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Medyna Marta,",
   "children": []
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Szklarski Jacek,",
   "children": []
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Toczek Marcin,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Andrzejczuk Henryk,",
   "children": []
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Gąsior Paweł Marek,",
   "children": []
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Praszczyk Andrzej Hilary,",
   "children": []
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Praszczyk Bożena,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w rozwijaniu polsko-amerykańskiej współpracy gospodarczej, za wspieranie polskiego i polonijnego biznesu"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Herchold Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w popularyzowaniu polskiej kultury i sztuki"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Poskrobko-Strzęciwilk Janina.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
