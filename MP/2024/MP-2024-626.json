   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 21 maja 2024 r."
  },
  {
   "type": "text",
   "text": "nr 1130.19.2024"
  },
  {
   "type": "text",
   "text": "o powołaniu do pełnienia urzędu na stanowisku sędziego"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 179 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r., na wniosek Krajowej Rady Sądownictwa, powołuję niżej wymienione osoby do pełnienia urzędu:"
  },
  {
   "type": "text",
   "text": "na stanowisku sędziego Sądu Apelacyjnego:"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Damian Paweł Krakowiak – w Łodzi,",
   "children": [
    {
     "type": "text",
     "text": "na stanowisku sędziego Sądu Okręgowego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Anna Elżbieta Glijerska-Socha – w Świdnicy,",
   "children": []
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Agnieszka Katarzyna Pasternak – w Sosnowcu,",
   "children": [
    {
     "type": "text",
     "text": "na stanowisku sędziego Sądu Rejonowego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Marlena Elżbieta Chojnacka – w Kaliszu,",
   "children": []
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Aneta Jaźwińska – dla Warszawy-Mokotowa w Warszawie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Magdalena Sąsiadek – w Tarnowskich Górach,",
   "children": []
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Andrzej Załęski – w Białej Podlaskiej.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
