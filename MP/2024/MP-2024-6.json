   "text": "ZARZĄDZENIE NR 655"
  },
  {
   "type": "text",
   "text": "PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 29 grudnia 2023 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Rodziny, Pracy i Polityki Społecznej"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2022 r. poz. 1188 oraz z 2023 r. poz. 1195, 1234 i 1641) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Rodziny, Pracy i Polityki Społecznej nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 150 Prezesa Rady Ministrów z dnia 20 sierpnia 2021 r. w sprawie nadania statutu Ministerstwu Rodziny i Polityki Społecznej (M.P. poz. 766 oraz z 2022 r. poz. 1087).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie z dniem następującym po dniu ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: D. Tusk"
  }
 ],
