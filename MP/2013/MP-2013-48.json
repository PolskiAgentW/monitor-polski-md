   "type": "text",
   "text": "ZARZĄDZENIE Nr 5"
  },
  {
   "type": "text",
   "text": "PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 30 stycznia 2013 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Edukacji Narodowej"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2012 r. poz. 392) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Edukacji Narodowej nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 29 Prezesa Rady Ministrów z dnia 9 kwietnia 2009 r. w sprawie nadania statutu Ministerstwu Edukacji Narodowej (M.P. Nr 22, poz. 290, z 2010 r. Nr 99, poz. 1170 oraz z 2012 r. poz. 80).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie po upływie 7 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: D. Tusk"
  }
 ],
