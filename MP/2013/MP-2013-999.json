  },
  {
   "type": "text",
   "text": "o powołaniu do pełnienia urzędu na stanowisku sędziego"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 179 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r., na wniosek Krajowej Rady Sądownictwa, powołuję niżej wymienione osoby do pełnienia urzędu:"
  },
  {
   "type": "text",
   "text": "I. na stanowisku sędziego Sądu Okręgowego:"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Grzegorz MACIEJOWSKI – w Rzeszowie",
   "children": [
    {
     "type": "text",
     "text": "II. na stanowisku sędziego Sądu Rejonowego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Andrzej Paweł BRONISZ – w Chełmie",
