 "title": "Obwieszczenie Ministra Środowiska z dnia 28 września 2020 r. w sprawie stawek opłat na rok 2021 z zakresu przepisów Prawa geologicznego i górniczego",
 "converter": "eli2md 0.6.25.1",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2020/894/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "OBWIESZCZENIE"
  },
  {
   "type": "text",
   "text": "MINISTRA ŚRODOWISKA[^1]"
  },
  {
   "type": "text",
   "text": "z dnia 28 września 2020 r."
  },
  {
   "type": "text",
   "text": "w sprawie stawek opłat na rok 2021 z zakresu przepisów Prawa geologicznego i górniczego"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 136 ust. 2 ustawy z dnia 9 czerwca 2011 r. – Prawo geologiczne i górnicze (Dz. U. z 2020 r. poz. 1064 i 1339) ogłasza się, obowiązujące na rok 2021, stawki opłat:"
  },
  {
   "type": "pkt",
   "num": "1",
   "path": "pkt_1",
   "text": "za działalność w zakresie poszukiwania złóż kopalin za kilometr kwadratowy,",
   "children": []
  },
  {
   "type": "pkt",
   "num": "2",
   "path": "pkt_2",
   "text": "za działalność w zakresie poszukiwania kompleksu podziemnego składowania dwutlenku węgla,",
   "children": []
  },
  {
   "type": "pkt",
   "num": "3",
   "path": "pkt_3",
   "text": "za działalność w zakresie poszukiwania i rozpoznawania złóż węglowodorów za kilometr kwadratowy,",
   "children": []
  },
  {
   "type": "pkt",
   "num": "4",
   "path": "pkt_4",
   "text": "eksploatacyjnych,",
   "children": []
  },
  {
   "type": "pkt",
   "num": "5",
   "path": "pkt_5",
   "text": "z tytułu podziemnego bezzbiornikowego magazynowania substancji,",
   "children": []
  },
  {
   "type": "pkt",
   "num": "6",
   "path": "pkt_6",
   "text": "z tytułu podziemnego składowania odpadów,",
   "children": []
  },
  {
   "type": "pkt",
   "num": "7",
   "path": "pkt_7",
   "text": "z tytułu podziemnego składowania dwutlenku węgla",
   "children": []
  },
  {
   "type": "text",
   "text": "– określone w załączniku do obwieszczenia."
  },
  {
   "type": "signature",
   "text": "Minister Środowiska: M. Woś"
  }
 ],
