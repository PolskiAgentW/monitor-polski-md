    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz samorządu lekarskiego"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
