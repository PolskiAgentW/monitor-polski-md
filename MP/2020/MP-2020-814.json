 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 3 lipca 2020 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.25.1",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2020/814/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 225/2020"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 3 lipca 2020 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2020 r. poz. 138) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za zasługi w działalności społecznej na rzecz ochrony przeciwpożarowej"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Niedbała Tomasz,",
   "children": [
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Król Józef,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Nauki i Szkolnictwa Wyższego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności naukowo-badawczej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Kasperkiewicz-Wasilewska Paulina Maria, 4. Poręba Marcin Łukasz, 5. Rut Wioletta Katarzyna,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Groborz Katarzyna Małgorzata,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podkarpackiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz ochrony przeciwpożarowej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Lewandowski Wojciech Andrzej.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
