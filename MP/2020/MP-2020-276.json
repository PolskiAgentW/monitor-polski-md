{
 "eli": "MP/2020/276",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 17 stycznia 2020 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.7",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2020/276/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 20/2020"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 17 stycznia 2020 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2019 r. poz. 25, 730 i 992) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Kultury i Dziedzictwa Narodowego"
  },
  {
   "type": "text",
   "text": "za zasługi dla kultury polskiej"
  },
  {
   "type": "text",
   "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Kędziora Grażyna Zofia, 2. Lelewska-Drążkowska Izabela Teresa,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Obrony Narodowej"
    },
    {
     "type": "text",
     "text": "za zasługi dla obronności i suwerenności kraju:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "gen. bryg. Molenda Karol Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "st. chor. szt. Lozia Andrzej Jan,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podkarpackiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju muzealnictwa, za upowszechnianie historii i kultury polskiej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Banach Wiesław Józef,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Świętokrzyskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz zachowania i upamiętniania wartości narodowych:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "ppłk Tomalski Mariusz, BRĄZOWYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "płk Barański Artur Rafał, 8. płk Chabielski Paweł Janusz, 9. mjr Szostak Andrzej Robert, 10. Woś Daniel Rafał,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Wielkopolskiego"
    },
    {
     "type": "text",
     "text": "za zasługi dla kultury polskiej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Goerlich Jarosław Józef, 12. Klóska Paweł Adam.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
