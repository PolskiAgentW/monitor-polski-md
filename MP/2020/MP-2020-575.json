 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 16 kwietnia 2020 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.7",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2020/575/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 121/2020"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 16 kwietnia 2020 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2020 r. poz. 138) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Spraw Wewnętrznych i Administracji:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM ZASŁUGI ZA DZIELNOŚĆ"
  },
  {
   "type": "text",
   "text": "za zasługi w ratowaniu życia ludzkiego:"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "st. post. Kmiecik Damian Krzysztof, 2. sierż. szt. Wołkowicz Marek Paweł,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w ratowaniu mienia:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "st. asp. Gędłek Grzegorz, 4. Gołdyn Karol,",
   "children": [
    {
     "type": "text",
     "text": "MEDALEM ZA OFIARNOŚĆ I ODWAGĘ"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "sierż. szt. Gorski Grzegorz Jarosław, 6. Joniec Krzysztof Joachim, 7. Wojciechowski Adrian,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Mazowieckiego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Ignatowicz Maciej Karol, 9. Potrac Radosław Joachim,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Śląskiego"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Bartoń Krzysztof Piotr,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Zachodniopomorskiego"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Sławczyński Robert.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
