 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE NR 5"
  },
  {
   "type": "text",
   "text": "PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 17 stycznia 2020 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Rozwoju"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2019 r. poz. 1171) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Rozwoju nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Zarządzenie wchodzi w życie z dniem następującym po dniu ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: M. Morawiecki"
  }
 ],
 "annexes": [
  {
   "heading": "Załącznik do zarządzenia nr 5 Prezesa Rady Ministrów z dnia 17 stycznia 2020 r. (poz. 75)",
   "body": [
    {
     "type": "text",
     "text": "STATUT MINISTERSTWA ROZWOJU"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Rozwoju, zwane dalej „Ministerstwem”, zapewnia obsługę Ministra Rozwoju, zwanego dalej „Ministrem”, właściwego na podstawie rozporządzenia Prezesa Rady Ministrów z dnia 18 listopada 2019 r. w sprawie szczegółowego zakresu działania Ministra Rozwoju (Dz. U. poz. 2261), do spraw objętych działami administracji rządowej:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/pkt_1",
       "text": "budownictwo, planowanie i zagospodarowanie przestrzenne oraz mieszkalnictwo;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/pkt_2",
       "text": "gospodarka;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_1/pkt_3",
       "text": "turystyka.",
       "children": []
      }
     ]
    },
    {
     "type": "par",
     "num": "2",
     "path": "par_2",
