     "text": "w § 2:",
     "children": [
      {
       "type": "lit",
       "num": "a",
       "path": "par_1/pkt_1/lit_a",
       "text": "po pkt 7 dodaje się pkt 7a w brzmieniu:",
       "children": [
        {
         "type": "text",
         "text": "„7a) Departament Legislacyjny Ustroju Sądów;”,",
         "quoted": true
        }
