   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "30",
   "path": "ust_30",
   "text": "Kondrat Wojciech, 31. Żernicki Józef Zenon,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz środowisk kombatanckich"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "32",
   "path": "ust_32",
   "text": "Deręgowska Bernadetta Irena,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w pielęgnowaniu pamięci o najnowszej historii Polski:"
