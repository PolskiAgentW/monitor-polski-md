    {
     "type": "text",
     "text": "na wniosek Wojewody Kujawsko-Pomorskiego"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "33",
   "path": "ust_33",
   "text": "Gadzinowski Jerzy Mieczysław, 34. Mickuś Jerzy Wojciech, 35. Paczoska-Hauke Alicja, 36. Rydel Piotr Eugeniusz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Mazowieckiego:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "37",
   "path": "ust_37",
   "text": "Roskowiński Rafał Władysław, BRĄZOWYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "38",
   "path": "ust_38",
   "text": "Cypel Sławomir, 39. Janiak Daniel Kamil, 40. Janiszewski Zbigniew, 41. Posmyk Tomasz, 42. Szkopek Marceli,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podkarpackiego:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "43",
   "path": "ust_43",
   "text": "Surdej Mirosław Jacek,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
