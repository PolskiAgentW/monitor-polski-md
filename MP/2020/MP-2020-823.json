{
 "eli": "MP/2020/823",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 21 lipca 2020 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.25.1",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2020/823/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 265/2020"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 21 lipca 2020 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2020 r. poz. 138) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM ZASŁUGI ZA DZIELNOŚĆ"
  },
  {
   "type": "text",
   "text": "za zasługi w ratowaniu życia ludzkiego"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Spraw Wewnętrznych i Administracji:"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "sierż. Miedzik Mateusz, 2. asp. szt. Okoń Marcin Mariusz, 3. sierż. szt. Śledź Robert Dariusz,",
   "children": [
    {
     "type": "text",
     "text": "MEDALEM ZA OFIARNOŚĆ I ODWAGĘ"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego:"
    },
    {
     "type": "text",
     "text": "na wniosek Ministra Finansów:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Janiak Sławomir, 5. Ławicki Krzysztof Waldemar,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Dolnośląskiego"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Kurzątkowski Jakub,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego i mienia"
    },
    {
     "type": "text",
     "text": "na wniosek Wojewody Mazowieckiego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Chilimończyk Paweł Mariusz, 8. Herman Dariusz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w ratowaniu mienia"
    },
    {
     "type": "text",
     "text": "na wniosek Wojewody Podlaskiego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Kuczyński Wojciech, 10. Laskowski Gustaw Sławomir.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
