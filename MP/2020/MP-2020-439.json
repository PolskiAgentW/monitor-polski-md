 "body": [
  {
   "type": "text",
   "text": "Rej. 51/2020"
  },
  {
   "type": "text",
   "text": "Postanowienie"
  },
  {
   "type": "text",
   "text": "Prezydenta rzeczyPosPolitej Polskiej"
  },
  {
   "type": "text",
   "text": "z dnia 21 lutego 2020 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2020 r. poz. 138) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za zasługi dla kultury polskiej"
  },
  {
   "type": "text",
   "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "ppor. Flis Piotr,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Infrastruktury"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju budownictwa"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Witkowski Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Zdrowia"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i charytatywnej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Donimirski Jerzy Maria,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Dziuba Arkadiusz Jan, 5. Hojda-Nowak Anna Maria, 6. Nowak Ewelina, 7. Skolmowska Edyta Anna, 8. Wesołowska-Starzec Hanna Maria,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Kujawsko-Pomorskiego"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Kościński Sławomir Edmund, 10. Przybylski Artur,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w popularyzowaniu strzelectwa sportowego"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Rosiński Krzysztof Stanisław, na wniosek Wojewody Lubelskiego",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla kultury polskiej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Chomik-Kazarian Teresa,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Łódzkiego"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności związkowej na rzecz środowiska kolejarzy"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Brzóskowska Marianna,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w upamiętnianiu historii Polski:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Głowacz Daniel Franciszek, 15. Grabowska Irena Elżbieta, 16. Spirydonow Michał Maciej, 17. Wesołowski Zbigniew Ignacy,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Małopolskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "18",
   "path": "ust_18",
   "text": "Ciupek Krzysztof Stanisław, 19. Halski Radosław Maciej,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Mazowieckiego"
    },
    {
     "type": "text",
     "text": "za zasługi w upamiętnianiu historii Polski:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Olichwiruk Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "21",
   "path": "ust_21",
   "text": "Filipowiak Miłosz Władysław, 22. Milewski Edward, 23. Nikołajuk Jan, 24. Tomaszewski Bogusław Andrzej, 25. Waseńczuk Piotr Bartosz,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "26",
   "path": "ust_26",
   "text": "Smater Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz upamiętniania Żołnierzy Wyklętych:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "27",
   "path": "ust_27",
   "text": "Stępień-Jurzyk Małgorzata Anna, 28. Wieszczycka Anna Karina,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podkarpackiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej, za wkład w rozwój samorządności"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "29",
   "path": "ust_29",
   "text": "Berestecki Andrzej, na wniosek Wojewody Pomorskiego",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz rozwoju polskiej gospodarki morskiej, za propagowanie wartości patriotycznych"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "30",
   "path": "ust_30",
   "text": "Szubrycht Tomasz Ryszard,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Śląskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej, za wkład w rozwój samorządu pielęgniarskiego:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "Korzonkiewicz Małgorzata,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "32",
   "path": "ust_32",
   "text": "Gawlas-Kaczmarczyk Leokadia Stefania, 33. Pochłódka Krystyna, 34. Syguła Krystyna Regina,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Warmińsko-Mazurskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "35",
   "path": "ust_35",
   "text": "Kotewicz Marian Andrzej, 36. Ławicki Roch Józef.",
   "children": []
  },
  {
