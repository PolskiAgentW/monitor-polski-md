   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "35",
   "path": "ust_35",
   "text": "Kawecki Klaudiusz Rafał, 36. Małysa Małgorzata Barbara, 37. Mardausz Jolanta Maria, 38. Panek Marek, 39. Tomczak Bożena Małgorzata,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony zdrowia:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "40",
   "path": "ust_40",
   "text": "Pankowski Juliusz Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "41",
   "path": "ust_41",
   "text": "Brzozowska Helena,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju kolejnictwa"
    }
   ]
  },
  {
   "type": "ust",
   "num": "42",
   "path": "ust_42",
   "text": "Karkula Janusz Robert,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i samorządowej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "43",
   "path": "ust_43",
   "text": "Morawiec Witold Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "44",
   "path": "ust_44",
   "text": "Ciuła Szczepan Rafał, 45. Stachowicz Paweł Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "za wkład w rozwój innowacyjności w budownictwie:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "46",
   "path": "ust_46",
   "text": "Fedorczak-Cisak Małgorzata Teresa, 47. Furtak Marcin Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności naukowej i społecznej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "48",
   "path": "ust_48",
   "text": "Stepan Kamil Janusz,",
   "children": [
    {
     "type": "text",
     "text": "za wkład w rozwój budownictwa"
    }
   ]
  },
  {
   "type": "ust",
   "num": "49",
   "path": "ust_49",
   "text": "Zapart Marek Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Śląskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "50",
   "path": "ust_50",
   "text": "Lipowski Marek Zdzisław, 51. Trusz Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "52",
