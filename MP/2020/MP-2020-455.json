   "text": "Honysz Benedykt Wiktor,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "53",
   "path": "ust_53",
   "text": "Niemira-Adamczyk Piotr Stanisław, 54. Ochojski Piotr Paweł, za zasługi w działalności społecznej i charytatywnej",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "55",
   "path": "ust_55",
   "text": "Marcinkiewicz Barbara,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "56",
