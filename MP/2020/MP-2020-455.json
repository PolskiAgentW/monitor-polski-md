   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Łódzkiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "28",
   "path": "ust_28",
   "text": "Bartczak Grzegorz Franciszek, 29. Gajdka Ryszard Florian,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Małopolskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i duszpasterskiej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "30",
   "path": "ust_30",
   "text": "ks. Dudziak Leszek,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i charytatywnej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "Kania Aleksandra Danuta, 32. Wrzecionek Adam, SREBRNYM KRZYŻEM ZASŁUGI",
   "children": []
  },
