     "text": "na wniosek Wojewody Lubelskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju samorządu zawodowego pielęgniarek i położnych"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "23",
   "path": "ust_23",
   "text": "Tytuła Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Lubuskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz samorządu lekarskiego:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "24",
   "path": "ust_24",
   "text": "Kotuła Jacek,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "25",
   "path": "ust_25",
