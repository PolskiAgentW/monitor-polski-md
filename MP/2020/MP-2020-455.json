   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "62",
   "path": "ust_62",
   "text": "Andrzejewski Wojciech Florian,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w upowszechnianiu wiedzy historycznej, za propagowanie dziejów polskiej kawalerii:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
