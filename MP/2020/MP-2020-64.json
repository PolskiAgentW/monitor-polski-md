 "body": [
  {
   "type": "text",
   "text": "Rej. 534/2019"
  },
  {
   "type": "text",
   "text": "Postanowienie"
  },
  {
   "type": "text",
   "text": "Prezydenta rzeczyPosPolitej Polskiej"
  },
  {
   "type": "text",
   "text": "z dnia 21 października 2019 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2019 r. poz. 25, 730 i 992) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Obrony Narodowej"
  },
  {
   "type": "text",
   "text": "za zasługi w ratowaniu mienia:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM ZASŁUGI ZA DZIELNOŚĆ"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "mjr Bieniek Adam Grzegorz, 2. st. szer. Maziarz Michał, 3. st. szer. Smogorzewski Dariusz Maciej, 4. kpt. Zdanewicz Michał Piotr,",
   "children": [
    {
     "type": "text",
     "text": "MEDALEM ZA OFIARNOŚĆ I ODWAGĘ"
    },
    {
     "type": "text",
     "text": "na wniosek Ministra Infrastruktury"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu mienia"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Filak Barbara Bożena,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Łódzkiego"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu mienia"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Tosik Andrzej Adam,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Opolskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Brodnicki Sebastian Łukasz, 8. Olba Rafał Zygmunt, 9. Ratajczyk Józef, 10. Wychowaniec Leszek Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podkarpackiego"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Dziuban Dawid, na wniosek Wojewody Śląskiego",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Bandurski Daniel Dawid, 13. Malcharczyk Andrzej, 14. Skupin Łukasz Adrian,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Warmińsko-Mazurskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego"
    }
   ]
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "podinsp. Pach Henryk Jacek.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
