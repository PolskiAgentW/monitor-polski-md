{
 "eli": "MP/2020/281",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 28 stycznia 2020 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.25",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2020/281/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 25/2020"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 28 stycznia 2020 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2020 r. poz. 138) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Rolnictwa i Rozwoju Wsi"
  },
  {
   "type": "text",
   "text": "za zasługi w działalności na rzecz rozwoju polskiego rolnictwa:"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Nowacka Anna Albertyna, 2. Piszczek Jacek Józef,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Kałuski Tomasz, 4. Obrępalska-Stęplowska Aleksandra Julia,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Dobosz Renata Łucja, 6. Drzewiecki Sławomir, 7. Horoszkiewicz-Janka Joanna, 8. Kaczyński Piotr, 9. Nijak Katarzyna Małgorzata, 10. Płonka Marlena Agnieszka, 11. Trzmiel Katarzyna, 12. Zamojska Joanna Barbara,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Sportu"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania sportu"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Dziuba Marek,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Sprawiedliwości"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz dzieci i młodzieży, za przeciwdziałanie przemocy w rodzinie"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Pawlikowska-Adamczak Ewa Maria, 15. Nowaczyk Agnieszka Karolina,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Prezesa Instytutu Pamięci Narodowej"
    },
    {
     "type": "text",
     "text": "za zasługi w dokumentowaniu i upamiętnianiu prawdy o najnowszej historii Polski"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "16",
   "path": "ust_16",
   "text": "Nawrocki Karol Tadeusz, na wniosek Prezesa Polskiej Akademii Nauk",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju nauki:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Filip Małgorzata Maria, 18. Wardas Jadwiga Stanisława,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Mika Joanna Gabriela,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Gołembiowska Krystyna Czesława, 21. Jantas Danuta Maria, 22. Kajta Małgorzata, 23. Roman Adam, 24. Starowicz-Bubak Katarzyna Maria, 25. Szewczyk Bernadeta, 26. Tokarski Krzysztof,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Dolnośląskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz propagowania historii Polski oraz zachowania tożsamości kulturowej regionu:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "27",
   "path": "ust_27",
   "text": "Hebzda-Sołogub Beata,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "28",
   "path": "ust_28",
   "text": "Sołogub Piotr Adam,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Lubelskiego"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i charytatywnej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "29",
   "path": "ust_29",
   "text": "Bednarski Jacek Mariusz, 30. Sidor Marek,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w upowszechnianiu i kultywowaniu dziedzictwa narodowego"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "Wójcik Katarzyna Kinga,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Śląskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju turystyki"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "32",
   "path": "ust_32",
   "text": "Greń Krzysztof Franciszek,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Warmińsko-Mazurskiego:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi dla kultury polskiej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "33",
   "path": "ust_33",
   "text": "Ptaszyńska Eliza Kornelia,",
   "children": [
    {
     "type": "text",
     "text": "za upamiętnianie prawdy historycznej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "34",
   "path": "ust_34",
   "text": "Wołoszczak Grzegorz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przyrody"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "35",
   "path": "ust_35",
   "text": "Lwow-Kaczyński Jan, na wniosek Wojewody Wielkopolskiego",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania polskiego wędkarstwa:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "36",
   "path": "ust_36",
   "text": "Moździerski Andrzej Jarosław,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "37",
   "path": "ust_37",
   "text": "Czyżewski Kazimierz, 38. Osiński Bogdan, 39. Rozpłoch Ryszard Józef, 40. Teodorowicz Ryszard, 41. Węglowski Jan, 42. Wielgosz Eugeniusz, 43. Witt Henryk Rajmund,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Zachodniopomorskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "44",
   "path": "ust_44",
   "text": "Łagiewka Jacek Zygmunt.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
