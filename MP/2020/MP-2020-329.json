  {
   "type": "text",
   "text": "ZARZĄDZENIE NR 42"
  },
  {
   "type": "text",
   "text": "PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 31 marca 2020 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Środowiska"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2019 r. poz. 1171) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Środowiska nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Zarządzenie wchodzi w życie z dniem następującym po dniu ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: M. Morawiecki"
  }
 ],
 "annexes": [
  {
   "heading": "Załącznik do zarządzenia nr 42 Prezesa Rady Ministrów z dnia 31 marca 2020 r. (poz. 329)",
   "body": [
    {
     "type": "text",
     "text": "STATUT MINISTERSTWA ŚRODOWISKA"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Środowiska, zwane dalej „Ministerstwem”, zapewnia obsługę Ministra Środowiska, zwanego dalej „Ministrem”, właściwego, na podstawie rozporządzenia Prezesa Rady Ministrów z dnia 20 marca 2020 r. w sprawie szczegółowego zakresu działania Ministra Środowiska (Dz. U. poz. 494), do spraw objętych działem administracji rządowej – środowisko.",
     "children": []
    },
    {
     "type": "par",
     "num": "2",
     "path": "par_2",
     "text": "W skład Ministerstwa wchodzą Gabinet Polityczny Ministra oraz następujące komórki organizacyjne:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_2/pkt_1",
       "text": "Departament Bezpieczeństwa i Zarządzania Kryzysowego;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_2/pkt_2",
       "text": "Departament Edukacji Ekologicznej i Komunikacji;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_2/pkt_3",
       "text": "Departament Geologii i Koncesji Geologicznych;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_2/pkt_4",
       "text": "Departament Leśnictwa i Łowiectwa;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "par_2/pkt_5",
       "text": "Departament Nadzoru Geologicznego;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "6",
       "path": "par_2/pkt_6",
       "text": "Departament Ochrony Przyrody;",
       "children": []
