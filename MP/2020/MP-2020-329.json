       "children": []
      },
      {
       "type": "pkt",
       "num": "12",
       "path": "par_2/pkt_12",
       "text": "Biuro Ekonomiczno-Administracyjne;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "13",
