    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za krzewienie idei czerwonokrzyskiej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "22",
   "path": "ust_22",
   "text": "Ertelt Piotr, 23. Nowak Antoni Rafał, 24. Polczyk Jerzy Piotr, 25. Radzięta Łukasz Marcin,",
