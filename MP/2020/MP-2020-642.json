   "text": "Wasilewska Agata Barbara,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "35",
   "path": "ust_35",
   "text": "Frączek Wanda, 36. Kazun Dariusz Tadeusz, 37. Myrcha Danuta, 38. Szydłowska Ewa, 39. Zubkowicz Rafał,",
