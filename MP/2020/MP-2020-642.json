   "text": "Adamski Marek Robert, 8. Drożdż Artur, 9. Talowski Edward Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
