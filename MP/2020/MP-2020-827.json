{
 "eli": "MP/2020/827",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 16 lipca 2020 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.7",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2020/827/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 271/2020"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 16 lipca 2020 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2020 r. poz. 138) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności na rzecz pielęgnowania pamięci o najnowszej historii Polski"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Adamkiewicz Lucyna Alicja, 2. Nowakowska Katarzyna,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla niepodległości Rzeczypospolitej Polskiej, za pielęgnowanie pamięci o najnowszej historii Polski"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Ciborska Dobrosława,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla niepodległości Rzeczypospolitej Polskiej:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Werner Barbara, 5. Wojciechowski Wacław,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Koszalska Leokadia, 7. Lipiński Stanisław, 8. Richter Wincenty Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz upamiętniania prawdy o najnowszej historii Polski:"
    },
    {
     "type": "text",
     "text": "na wniosek Wojewody Lubuskiego"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Myśliński Piotr Konrad,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Mazowieckiego:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Zydel Robert, SREBRNYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Stefani Remigiusz Jacek,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Filipczuk Dorota, 13. Wyszomierski Paweł Hubert.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
