 "eli": "MP/2020/826",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 21 lipca 2020 r. o nadaniu orderu i odznaczeń",
 "converter": "eli2md 0.6.25.1",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2020/826/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 270/2020"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 21 lipca 2020 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderu i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2020 r. poz. 138) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi na rzecz ruchu Olimpiad Specjalnych"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Apryas Alina Aleksandra,",
   "children": [
    {
     "type": "text",
     "text": "za osiągnięcia w pracy szkoleniowej i trenerskiej, za zasługi dla rozwoju i upowszechniania sportu:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "po raz drugi"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Ostrykiewicz Henryk,",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Kubicki Mariusz Liwiusz,",
   "children": [
    {
     "type": "text",
     "text": "za osiągnięcia sportowe, za promowanie Polski na arenie międzynarodowej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Andrzejak Halina Maria, 5. Gredka Paweł Piotr.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
