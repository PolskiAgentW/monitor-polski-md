 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE NR 255"
  },
  {
   "type": "text",
   "text": "PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 31 grudnia 2020 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Edukacji i Nauki"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2019 r. poz. 1171 oraz z 2020 r. poz. 568, 695 i 2320) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Edukacji i Nauki nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Tracą moc:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_2/pkt_1",
     "text": "zarządzenie nr 31 Prezesa Rady Ministrów z dnia 9 marca 2016 r. w sprawie nadania statutu Ministerstwu Edukacji Narodowej (M.P. poz. 225, z 2017 r. poz. 1113 oraz z 2018 r. poz. 271);",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_2/pkt_2",
     "text": "zarządzenie nr 6 Prezesa Rady Ministrów z dnia 22 stycznia 2019 r. w sprawie nadania statutu Ministerstwu Nauki i Szkolnictwa Wyższego (M.P. poz. 118).",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie z dniem 1 stycznia 2021 r.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: M. Morawiecki"
  }
 ],
