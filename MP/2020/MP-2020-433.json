{
 "eli": "MP/2020/433",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 6 lutego 2020 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.7",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2020/433/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 41/2020"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 6 lutego 2020 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2020 r. poz. 138) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi dla niepodległości Rzeczypospolitej Polskiej:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Przyłuski Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Mazek Władysław, 3. Węgrzyniak-Białek Irena,",
   "children": [
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Czarnota Janina,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w obronie godności, człowieczeństwa i praw ludzkich, za ofiarną służbę w ratowaniu życia i zdrowia potrzebującym pomocy, za prowadzenie tajnego nauczania w okresie II wojny światowej"
    },
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Trojanowska Helena s. Maria Anzelma,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Szefa Urzędu do Spraw Kombatantów i Osób Represjonowanych:"
    },
    {
     "type": "text",
     "text": "za zasługi dla niepodległości Rzeczypospolitej Polskiej, za działalność kombatancką i społeczną"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Broel-Plater Jacek Ludwik,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla niepodległości Rzeczypospolitej Polskiej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Łoś Grzegorz.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
