 "body": [
  {
   "type": "text",
   "text": "Rej. 217/2015"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 10 czerwca 2015 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2015 r. poz. 475 i 1266) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Spraw Wewnętrznych"
  },
  {
   "type": "text",
   "text": "za zasługi w ratowaniu życia ludzkiego"
  },
  {
   "type": "text",
   "text": "KRZYŻEM ZASŁUGI"
  },
  {
   "type": "text",
   "text": "ZA DZIELNOŚĆ"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "str. Czopek Daniel, 2. mł. ogn. Czubacki Radosław Jacek,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Łódzkiego"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego i mienia"
    },
    {
     "type": "text",
     "text": "MEDALEM"
    },
    {
     "type": "text",
     "text": "ZA OFIARNOŚĆ I ODWAGĘ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Kaźmierczak Piotr Wacław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Małopolskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego i mienia"
    },
    {
     "type": "text",
     "text": "MEDALEM"
    },
    {
     "type": "text",
     "text": "ZA OFIARNOŚĆ I ODWAGĘ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Ciupka Michał, 5. Tomasik Przemysław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Mazowieckiego"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego i mienia"
    },
    {
     "type": "text",
     "text": "MEDALEM"
    },
    {
     "type": "text",
     "text": "ZA OFIARNO ŚĆ I ODWAG Ę"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Kozłowski Andrzej, 7. Pracownik Mirosław Leszek.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: B. Komorowski"
  }
 ],
