 "body": [
  {
   "type": "text",
   "text": "Rej. 327/2015"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 4 sierpnia 2015 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2015 r. poz. 475 i 1266) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Spraw Wewnętrznych"
  },
  {
   "type": "text",
   "text": "za zasługi w ratowaniu życia ludzkiego i mienia"
  },
  {
   "type": "text",
   "text": "KRZYŻEM ZASŁUGI"
  },
  {
   "type": "text",
   "text": "ZA DZIELNOŚĆ"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "sierż. Akacki Mariusz, 2. sierż. szt. Bartoszewski Paweł, 3. sierż. szt. Górowski Kamil Antoni, 4. sierż. Grobelny Damian Robert, 5. sierż. szt. Pęcherz Damian Jan, 6. sierż. szt. Sobolewski Karol,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Administracji i Cyfryzacji:"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu mienia"
    },
    {
     "type": "text",
     "text": "MEDALEM"
    },
    {
     "type": "text",
     "text": "ZA OFIARNOŚĆ I ODWAGĘ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Kotus Filip, 8. Paszkowska Dorota Elżbieta,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego"
    },
    {
     "type": "text",
     "text": "MEDALEM"
    },
    {
     "type": "text",
     "text": "ZA OFIARNOŚĆ I ODWAGĘ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Pela Jarosław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Małopolskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego i mienia"
    },
    {
     "type": "text",
     "text": "MEDALEM"
    },
    {
     "type": "text",
     "text": "ZA OFIARNO ŚĆ I ODWAG Ę"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Korna ś Jacek, 11. Kuciel Bolesław, 12. Słotwi ń ski Zdzisław.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: B. Komorowski"
  }
 ],
