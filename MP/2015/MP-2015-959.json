{
 "eli": "MP/2015/959",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 3 sierpnia 2015 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.25",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2015/959/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 322/2015"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 3 sierpnia 2015 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2015 r. poz. 475 i 1266) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności na rzecz przystąpienia Polski do NATO, za umacnianie bezpieczeństwa i obronności kraju, za rozwijanie stosunków euro-atlantyckich:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Kardasz Ryszard, 2. Pastusiak Longin Hieronim,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Smólski Bogusław,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Karkoszka Andrzej, 5. Trofiniak Krzysztof Jacek,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz przystąpienia Polski do NATO, za umacnianie bezpieczeństwa i obronności kraju, za rozwijanie stosunków euro-atlantyckich:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Drabczyński Paweł Zbigniew, 7. Jędruch Józef, 8. Krystowski Krzysztof, 9. Wojciechowski Piotr, 10. Wośko Marek,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Magadzio Sebastian Wojciech,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Piątkowski Krystian Artur.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: B. Komorowski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
