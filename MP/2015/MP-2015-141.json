   "text": "ZARZĄDZENIE NR 8"
  },
  {
   "type": "text",
   "text": "PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 23 stycznia 2015 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Sprawiedliwości"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2012 r. poz. 392) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Sprawiedliwości nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 14 Prezesa Rady Ministrów z dnia 28 lutego 2012 r. w sprawie nadania statutu Ministerstwu Sprawiedliwości (M.P. z 2014 r. poz. 18).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie z dniem 1 lutego 2015 r.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: E. Kopacz"
  }
 ],
