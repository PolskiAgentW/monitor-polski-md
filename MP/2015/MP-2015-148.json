  {
   "type": "text",
   "text": "OBWIESZCZENIE"
  },
  {
   "type": "text",
   "text": "PREZESA NARODOWEGO BANKU POLSKIEGO"
  },
  {
   "type": "text",
   "text": "z dnia 26 stycznia 2015 r."
  },
  {
   "type": "text",
   "text": "w sprawie ogłoszenia wykazu walut wymienialnych"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 4 ustawy z dnia 27 lipca 2002 r. – Prawo dewizowe (Dz. U. z 2012 r. poz. 826 oraz z 2013 r. poz. 1036) ogłasza się, co następuje:"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Walutami wymienialnymi są waluty obce, wymienione w załączniku do obwieszczenia.",
   "children": []
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Obwieszczenie obowiązuje od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Narodowego Banku Polskiego: M. Belka"
  }
 ],
