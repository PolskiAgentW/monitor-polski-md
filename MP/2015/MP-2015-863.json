     "type": "text",
     "text": "STATUT MINISTERSTWA INFRASTRUKTURY I ROZWOJU"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Infrastruktury i Rozwoju, zwane dalej „Ministerstwem”, zapewnia obsługę Ministra Infrastruktury i Rozwoju, zwanego dalej „Ministrem”, właściwego, na podstawie rozporządzenia Prezesa Rady Ministrów z dnia 27 listopada 2013 r. w sprawie szczegółowego zakresu działania Ministra Infrastruktury i Rozwoju (Dz. U. poz. 1391)[^1], do spraw:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/pkt_1",
       "text": "budownictwa, lokalnego planowania i zagospodarowania przestrzennego oraz mieszkalnictwa;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/pkt_2",
       "text": "gospodarki morskiej;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_1/pkt_3",
       "text": "rozwoju regionalnego;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_1/pkt_4",
       "text": "transportu.",
       "children": []
