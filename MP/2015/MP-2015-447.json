   "type": "text",
   "text": "Rej. 85/2015"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 18 marca 2015 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2015 r. poz. 475) za zasługi w ratowaniu życia ludzkiego odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Obrony Narodowej:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM ZASŁUGI"
  },
  {
   "type": "text",
   "text": "ZA DZIELNOŚĆ"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "st. szer. Berun Michał Kamil, 2. sierż. Durda Tomasz Jan,",
   "children": [
    {
     "type": "text",
     "text": "MEDALEM"
    },
    {
     "type": "text",
     "text": "ZA OFIARNOŚĆ I ODWAGĘ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "płk Gładysz Marek Jan,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Spraw Wewnętrznych"
    },
    {
     "type": "text",
     "text": "KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "ZA DZIELNOŚĆ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "st. sierż. Mojsiejonek Monika, 5. sierż. szt. Osękowski Adam Jan, 6. st. sierż. Piłko Marcin Łukasz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Dolnośląskiego"
    },
    {
     "type": "text",
     "text": "MEDALEM"
    },
    {
     "type": "text",
     "text": "ZA OFIARNOŚĆ I ODWAGĘ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Opiłowski Paweł Krzysztof,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podkarpackiego"
    },
    {
     "type": "text",
     "text": "MEDALEM"
    },
    {
     "type": "text",
     "text": "ZA OFIARNO ŚĆ I ODWAG Ę"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Bury Zbigniew, 9. Chorz ę pa Paweł, 10. Krudysz Tomasz, 11. Rembisz Jacek, 12. Sidor Henryk, na wniosek Wojewody Warmińsko-Mazurskiego",
   "children": [
    {
     "type": "text",
     "text": "MEDALEM"
    },
    {
     "type": "text",
     "text": "ZA OFIARNOŚĆ I ODWAGĘ"
    }
   ]
  },
  {
   "type": "ust",
