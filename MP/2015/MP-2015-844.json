{
 "eli": "MP/2015/844",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 16 czerwca 2015 r. o nadaniu orderów",
 "converter": "eli2md 0.6.25",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2015/844/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 233/2015"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 16 czerwca 2015 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2015 r. poz. 475 i 1266) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności na rzecz rozwoju przemysłu mleczarskiego oraz ruchu spółdzielczego w Polsce"
  },
  {
   "type": "text",
   "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Badach Tadeusz Tomasz,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz rozwoju polskiego rolnictwa:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Jagieliński Roman,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Gołos Janusz,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności badawczej, za rozsławienie imienia Polski w świecie"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Pałkiewicz Edward,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne osiągnięcia w pracy zawodowej i działalności społecznej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Szleper Waldemar Mikołaj.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: B. Komorowski"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
