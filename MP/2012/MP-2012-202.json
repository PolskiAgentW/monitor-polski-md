 "converter": "eli2md 0.6.25",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2012/202/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE Nr 25"
  },
  {
   "type": "text",
   "text": "PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 5 kwietnia 2012 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Środowiska"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2003 r. Nr 24, poz. 199, z późn. zm.[^1]) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Środowiska nadaje się statut stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 134 Prezesa Rady Ministrów z dnia 2 grudnia 2008 r. w sprawie nadania statutu Ministerstwu Środowiska (M. P. Nr 92, poz. 789, z 2010 r. Nr 61, poz. 795 oraz z 2011 r. Nr 32, poz. 386).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie z dniem następującym po dniu ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: D. Tusk"
  }
 ],
 "annexes": [
  {
   "heading": "Załącznik do zarządzenia nr 25 Prezesa Rady Ministrów z dnia 5 kwietnia 2012 r. (poz. 202)",
   "body": [
    {
     "type": "text",
     "text": "STATUT MINISTERSTWA ŚRODOWISKA"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Środowiska, zwane dalej „Ministerstwem”, zapewnia obsługę Ministra Środowiska, zwanego dalej „Ministrem”, właściwego, na podstawie rozporządzenia Prezesa Rady Ministrów z dnia 18 listopada 2011 r. w sprawie szczegółowego zakresu działania Ministra Środowiska (Dz. U. Nr 248, poz. 1493 i Nr 284, poz. 1671), do spraw:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/pkt_1",
       "text": "gospodarki wodnej;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/pkt_2",
       "text": "środowiska.",
       "children": []
      }
     ]
    },
    {
     "type": "par",
     "num": "2",
     "path": "par_2",
     "text": "W skład Ministerstwa wchodzą Gabinet Polityczny Ministra oraz następujące komórki organizacyjne:",
     "children": [
