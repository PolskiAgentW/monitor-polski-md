    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "39",
   "path": "ust_39",
   "text": "Listwan Zygmunt, 40. Tomys Irena Barbara,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "41",
   "path": "ust_41",
   "text": "Baranowski Radosław Stanisław, 42. Sokołowska Małgorzata Ewa, 43. Świderski Marian Tadeusz, za zasługi w działalności na rzecz środowiska rybackiego i wędkarskiego",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "44",
   "path": "ust_44",
   "text": "Kleszcz Mariusz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Kujawsko-Pomorskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i popularyzacji wioślarstwa"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "po raz drugi"
    }
   ]
  },
  {
   "type": "ust",
