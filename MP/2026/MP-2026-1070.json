 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 6 sierpnia 2026 r."
  },
  {
   "type": "text",
   "text": "nr rej. 463/2026"
  },
  {
   "type": "text",
   "text": "o nadaniu orderu i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2023 r. poz. 2053) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności na rzecz wspierania i aktywizacji społecznej osób z niepełnosprawnościami i potrzebujących pomocy"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Ładnowska Elżbieta Bogumiła,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Lubuskiego:"
    },
    {
     "type": "text",
     "text": "za osiągnięcia sportowe, za promowanie Polski na arenie międzynarodowej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Mamczarz Łukasz Maciej,",
   "children": []
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Olszewska Milena Magdalena,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju sportu osób z niepełnosprawnościami, za osiągniecia w działalności szkoleniowej i trenerskiej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Woźniak Daniel Ryszard,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Konieczka Marek,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Stasiak Jacek Bolesław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz wspierania i aktywizacji społecznej osób z niepełnosprawnościami i potrzebujących pomocy:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Korzeniowska Małgorzata Krystyna,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Rajska-Pura Anna Kamila.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: K. Nawrocki"
  }
 ],
