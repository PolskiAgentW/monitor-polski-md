    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Beraza Miroslav,",
   "children": [
    {
     "type": "text",
     "text": "obywatelka Zjednoczonego Królestwa Wielkiej Brytanii i Irlandii Północnej i Republiki Cypryjskiej"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwijania polsko-cypryjskiej współpracy w dziedzinie archeologii"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
