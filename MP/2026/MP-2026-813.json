 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 19 czerwca 2026 r."
  },
  {
   "type": "text",
   "text": "nr rej. 335/2026"
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2023 r. poz. 2053) za zasługi w ratowaniu życia ludzkiego odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Spraw Wewnętrznych i Administracji"
  },
  {
   "type": "text",
   "text": "KRZYŻEM ZASŁUGI ZA DZIELNOŚĆ"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Sieroń Radosław Hubert,",
   "children": [
    {
     "type": "text",
     "text": "MEDALEM ZA OFIARNOŚĆ I ODWAGĘ"
    },
    {
     "type": "text",
     "text": "na wniosek Wojewody Kujawsko-Pomorskiego"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Napieralski Krzysztof,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Małopolskiego"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Bryl Artur Wojciech.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: K. Nawrocki"
  }
 ],
