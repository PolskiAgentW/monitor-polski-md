   "text": "OBWIESZCZENIE"
  },
  {
   "type": "text",
   "text": "PREZESA NARODOWEGO BANKU POLSKIEGO"
  },
  {
   "type": "text",
   "text": "z dnia 20 stycznia 2026 r."
  },
  {
   "type": "text",
   "text": "w sprawie ogłoszenia wykazu walut wymienialnych"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 4 ustawy z dnia 27 lipca 2002 r. – Prawo dewizowe (Dz. U. z 2024 r. poz. 1131) ogłasza się wykaz walut wymienialnych, stanowiący załącznik do obwieszczenia."
  },
  {
   "type": "signature",
   "text": "Prezes Narodowego Banku Polskiego: A. Glapiński"
  }
 ],
