 "converter": "eli2md 0.6.25.2",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2026/511/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE"
  },
  {
   "type": "text",
   "text": "MARSZAŁKA SEJMU RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 18 maja 2026 r."
  },
  {
   "type": "text",
   "text": "zmieniające zarządzenie w sprawie nadania statutu Państwowej Inspekcji Pracy"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 6 ust. 1 pkt 1 ustawy z dnia 13 kwietnia 2007 r. o Państwowej Inspekcji Pracy (Dz. U. z 2024 r. poz. 1712, z późn. zm.[^1]), zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "W zarządzeniu Marszałka Sejmu Rzeczypospolitej Polskiej z dnia 27 sierpnia 2007 r. w sprawie nadania statutu Państwowej Inspekcji Pracy (M.P. poz. 657, z 2009 r. poz. 76, z 2011 r. poz. 19 i 851 oraz z 2017 r. poz. 1189) w załączniku wprowadza się następujące zmiany:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "w § 4 ust. 1 otrzymuje brzmienie:",
     "children": [
      {
       "type": "text",
       "text": "„1. W skład Głównego Inspektoratu Pracy wchodzą następujące komórki organizacyjne:",
       "quoted": true
      },
      {
       "type": "text",
       "text": "1) Gabinet Głównego Inspektora Pracy;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "2) Departament Budżetu i Finansów;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "3) Departament Informatyki;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "4) Departament Kadr i Szkoleń;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "5) Departament Kontroli Wewnętrznej;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "6) Departament Legalności Zatrudnienia;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "7) Departament Nadzoru i Kontroli;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "8) Departament Organizacyjny;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "9) Departament Planowania, Analiz i Statystyki;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "10) Departament Prawny;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "11) Departament Prewencji i Promocji;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "12) Sekcja Audytu Wewnętrznego;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "13) Sekcja Centrum Poradnictwa Państwowej Inspekcji Pracy;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "14) Sekcja Zamówień Publicznych;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "15) Biuro Informacji;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "16) Kancelaria Tajna.”;",
       "quoted": true
      }
     ]
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "w § 5 w ust. 2 skreśla się wyrazy „i biura terenowe”.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Zarządzenie wchodzi w życie z dniem 1 czerwca 2026 r.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Marszałek Sejmu: W. Czarzasty"
  }
 ],
 "annexes": [],
 "footnotes": {
  "1": "Zmiany tekstu jednolitego wymienionej ustawy zostały ogłoszone w Dz. U. z 2025 r. poz. 321, 368, 620 i 769 oraz z 2026 r. poz. 160 i 473."
 }
