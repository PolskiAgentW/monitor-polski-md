   "children": []
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Wanat Monika,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w umacnianiu obronności i bezpieczeństwa państwa"
    },
    {
     "type": "text",
