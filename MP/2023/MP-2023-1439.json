 "converter": "eli2md 0.6.25.2",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2023/1439/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 16 listopada 2023 r."
  },
  {
   "type": "text",
   "text": "nr rej. 557/2023"
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2023 r. poz. 2053) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności na rzecz wspierania i aktywizacji społecznej osób z niepełnosprawnościami i potrzebujących pomocy"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Damentko Mariusz Bernard,",
   "children": []
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Szatkowska Alicja Antonina,",
   "children": []
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Tarnawska Danuta Brygida,",
   "children": [
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Jakubowski Marek Walenty,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne osiągnięcia sportowe, za działalność na rzecz rozwoju i upowszechniania sportu"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Makowski Stefan Władysław,",
   "children": []
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Pluta Grzegorz Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz osób z niepełnosprawnościami i potrzebujących pomocy:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Bukowski Janusz Witold,",
   "children": []
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Mela Jan,",
   "children": []
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Parus Paweł Jacek,",
   "children": []
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Tutka Ewa, s. Anuarita,",
   "children": []
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Wachowiak-Zwara Beata Bernadeta,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Zarzecki Robert, za osiągnięcia sportowe, za propagowanie aktywizacji społecznej osób z niepełnosprawnościami",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Ostałowski Bartosz Łukasz.",
   "children": []
  },
  {
