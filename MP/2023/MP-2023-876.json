 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 22 czerwca 2023 r."
  },
  {
   "type": "text",
   "text": "nr rej. 266/2023"
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczenia"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2022 r. poz. 1031) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi dla niepodległości Rzeczypospolitej Polskiej:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI pośmiertnie"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Banasik Bronisław,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Bittner Sławomir Maciej,",
   "children": []
