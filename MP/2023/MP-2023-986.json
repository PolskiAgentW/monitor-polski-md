 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 24 lipca 2023 r."
  },
  {
   "type": "text",
   "text": "nr rej. 345/2023"
  },
  {
   "type": "text",
   "text": "o nadaniu orderów"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2022 r. poz. 1031) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności państwowej i publicznej, za działalność na rzecz przemian demokratycznych w Polsce"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Wyrowiński Jan Alfons,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz przemian demokratycznych w Polsce"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Pasiński Grzegorz, pośmiertnie",
   "children": []
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "ks. Lipski Marian,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Olewnik Andrzej Antoni,",
   "children": []
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Trzęsicki Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Andrzejewski Marek,",
   "children": []
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Jędras Krystyna,",
   "children": []
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Samolej Tadeusz Leszek,",
   "children": []
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Szelewicz Sławomir,",
   "children": []
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Wojtan Henryk,",
   "children": []
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Wujkowski Witold, pośmiertnie:",
   "children": []
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Florkowski Longin Marek,",
   "children": []
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Wieczorkowski Andrzej Mariusz, obywatelka Królestwa Norwegii",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi we wspieraniu przemian demokratycznych w Polsce, za działalność na rzecz respektowania praw człowieka"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
