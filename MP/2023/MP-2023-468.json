{
 "eli": "MP/2023/468",
 "title": "Zarządzenie nr 87 Prezesa Rady Ministrów z dnia 25 kwietnia 2023 r. w sprawie Rady Wykonawczej do spraw wdrażania Krajowej Polityki Miejskiej 2030",
 "converter": "eli2md 0.6.25.2",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2023/468/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE NR 87"
  },
  {
   "type": "text",
   "text": "PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 25 kwietnia 2023 r."
  },
  {
   "type": "text",
   "text": "w sprawie Rady Wykonawczej do spraw wdrażania Krajowej Polityki Miejskiej 2030"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 12 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2022 r. poz. 1188) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_1/ust_1",
     "text": "Powołuje się Radę Wykonawczą do spraw wdrażania Krajowej Polityki Miejskiej 2030, zwaną dalej „Radą”.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_1/ust_2",
     "text": "Rada jest organem pomocniczym Rady Ministrów, kierowanym przez ministra właściwego do spraw rozwoju regionalnego, zwanego dalej „Ministrem”.",
     "children": []
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_1/ust_3",
     "text": "Rada koordynuje wdrażanie rozwiązań wskazanych w Krajowej Polityce Miejskiej 2030, zwanej dalej „KPM 2030”.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Do zadań Rady należy:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_2/pkt_1",
     "text": "monitorowanie wdrażania KPM 2030 w oparciu o przygotowany przez Ministra i przyjęty przez Radę plan implementacji KPM 2030, zwany dalej „planem implementacji”;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_2/pkt_2",
     "text": "ocena realizacji zadań określonych w planie implementacji i wynikających z KPM 2030, przypisanych poszczególnym ministrom i organom administracji rządowej;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_2/pkt_3",
     "text": "weryfikacja określonego w planie implementacji harmonogramu podejmowania działań w przypadku potrzeby dokonania zmian w planie implementacji;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_2/pkt_4",
     "text": "określanie zakresu tematycznego badań z zakresu rozwoju miast i ich obszarów funkcjonalnych;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_2/pkt_5",
     "text": "identyfikacja nowych wyzwań przez analizę czynników społecznych, gospodarczych, środowiskowych i przestrzennych oraz wyzwań zgłoszonych w procesie dialogu z samorządami miejskimi, organizacjami społecznymi i światem nauki;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "6",
     "path": "par_2/pkt_6",
     "text": "przyjmowanie sprawozdań z wykonania prac ujętych w planie implementacji;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "7",
     "path": "par_2/pkt_7",
     "text": "ewaluacja wpływu funduszy krajowych oraz europejskich na osiąganie celów KPM 2030;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "8",
     "path": "par_2/pkt_8",
     "text": "ocena realizacji celów KPM 2030 w innych politykach publicznych i strategiach sektorowych;",
     "children": []
    },
    {
     "type": "pkt",
     "num": "9",
     "path": "par_2/pkt_9",
     "text": "współdziałanie w ramach Krajowego Forum Miejskiego w zakresie promocji i edukacji dotyczącej rozwiązań wypracowywanych w procesie realizacji planu implementacji.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_3/ust_1",
     "text": "W skład Rady wchodzą:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_3/ust_1/pkt_1",
       "text": "przewodniczący Rady – Minister;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_3/ust_1/pkt_2",
       "text": "zastępca przewodniczącego Rady – sekretarz stanu albo podsekretarz stanu wskazany przez Ministra;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_3/ust_1/pkt_3",
       "text": "pozostali członkowie Rady:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "par_3/ust_1/pkt_3/lit_a",
         "text": "przedstawiciel Prezesa Rady Ministrów,",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "par_3/ust_1/pkt_3/lit_b",
         "text": "minister właściwy do spraw:",
         "children": [
          {
           "type": "tir",
           "num": "1",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_1",
           "text": "administracji publicznej,",
           "children": []
          },
          {
           "type": "tir",
           "num": "2",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_2",
           "text": "budownictwa, planowania i zagospodarowania przestrzennego oraz mieszkalnictwa,",
           "children": []
          },
          {
           "type": "tir",
           "num": "3",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_3",
           "text": "energii,",
           "children": []
          },
          {
           "type": "tir",
           "num": "4",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_4",
           "text": "klimatu,",
           "children": []
          },
          {
           "type": "tir",
           "num": "5",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_5",
           "text": "kultury i ochrony dziedzictwa narodowego,",
           "children": []
          },
          {
           "type": "tir",
           "num": "6",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_6",
           "text": "środowiska,",
           "children": []
          },
          {
           "type": "tir",
           "num": "7",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_7",
           "text": "transportu,",
           "children": []
          },
          {
           "type": "tir",
           "num": "8",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_8",
           "text": "gospodarki,",
           "children": []
          },
          {
           "type": "tir",
           "num": "9",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_9",
           "text": "pracy,",
           "children": []
          },
          {
           "type": "tir",
           "num": "10",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_10",
           "text": "zabezpieczenia społecznego,",
           "children": []
          },
          {
           "type": "tir",
           "num": "11",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_11",
           "text": "rodziny,",
           "children": []
          },
          {
           "type": "tir",
           "num": "12",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_12",
           "text": "finansów publicznych,",
           "children": []
          },
          {
           "type": "tir",
           "num": "13",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_13",
           "text": "rozwoju wsi,",
           "children": []
          },
          {
           "type": "tir",
           "num": "14",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_14",
           "text": "informatyzacji,",
           "children": []
          },
          {
           "type": "tir",
           "num": "15",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_15",
           "text": "oświaty i wychowania,",
           "children": []
          },
          {
           "type": "tir",
           "num": "16",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_16",
           "text": "aktywów państwowych,",
           "children": []
          },
          {
           "type": "tir",
           "num": "17",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_17",
           "text": "łączności,",
           "children": []
          },
          {
           "type": "tir",
           "num": "18",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_18",
           "text": "kultury fizycznej,",
           "children": []
          },
          {
           "type": "tir",
           "num": "19",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_19",
           "text": "gospodarki wodnej,",
           "children": []
          },
          {
           "type": "tir",
           "num": "20",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_20",
           "text": "instytucji finansowych,",
           "children": []
          },
          {
           "type": "tir",
           "num": "21",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_21",
           "text": "członkostwa Rzeczypospolitej Polskiej w Unii Europejskiej,",
           "children": []
          },
          {
           "type": "tir",
           "num": "22",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_22",
           "text": "szkolnictwa wyższego i nauki,",
           "children": []
          },
          {
           "type": "tir",
           "num": "23",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_23",
           "text": "turystyki,",
           "children": []
          },
          {
           "type": "tir",
           "num": "24",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_24",
           "text": "spraw wewnętrznych,",
           "children": []
          },
          {
           "type": "tir",
           "num": "25",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_25",
           "text": "zdrowia,",
           "children": []
          },
          {
           "type": "tir",
           "num": "26",
           "path": "par_3/ust_1/pkt_3/lit_b/tir_26",
           "text": "żeglugi śródlądowej,",
           "children": []
          }
         ]
        },
        {
         "type": "lit",
         "num": "c",
         "path": "par_3/ust_1/pkt_3/lit_c",
         "text": "Minister Obrony Narodowej,",
         "children": []
        },
        {
         "type": "lit",
         "num": "d",
         "path": "par_3/ust_1/pkt_3/lit_d",
         "text": "Minister Sprawiedliwości.",
         "children": []
        }
       ]
      }
     ]
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_3/ust_2",
     "text": "Przewodniczący Rady zaprasza do udziału w pracach Rady po jednym przedstawicielu:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_3/ust_2/pkt_1",
       "text": "Związku Miast Polskich;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_3/ust_2/pkt_2",
       "text": "Unii Metropolii Polskich imienia Pawła Adamowicza;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_3/ust_2/pkt_3",
       "text": "Unii Miasteczek Polskich;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_3/ust_2/pkt_4",
       "text": "Związku Samorządów Polskich;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "par_3/ust_2/pkt_5",
       "text": "Związku Województw Rzeczypospolitej Polskiej;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "6",
       "path": "par_3/ust_2/pkt_6",
       "text": "Związku Powiatów Polskich;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "7",
       "path": "par_3/ust_2/pkt_7",
       "text": "Związku Gmin Wiejskich Rzeczypospolitej Polskiej.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_3/ust_3",
     "text": "Przewodniczący Rady może zapraszać do udziału w pracach Rady z głosem doradczym:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_3/ust_3/pkt_1",
       "text": "przedstawicieli:",
       "children": [
        {
         "type": "lit",
         "num": "a",
         "path": "par_3/ust_3/pkt_1/lit_a",
         "text": "Narodowego Funduszu Ochrony Środowiska i Gospodarki Wodnej,",
         "children": []
        },
        {
         "type": "lit",
         "num": "b",
         "path": "par_3/ust_3/pkt_1/lit_b",
         "text": "Polskiego Funduszu Rozwoju S.A.,",
         "children": []
        },
        {
         "type": "lit",
         "num": "c",
         "path": "par_3/ust_3/pkt_1/lit_c",
         "text": "PFR Nieruchomości S.A.,",
         "children": []
        },
        {
         "type": "lit",
         "num": "d",
         "path": "par_3/ust_3/pkt_1/lit_d",
         "text": "Banku Gospodarstwa Krajowego,",
         "children": []
        },
        {
         "type": "lit",
         "num": "e",
         "path": "par_3/ust_3/pkt_1/lit_e",
         "text": "Krajowego Zasobu Nieruchomości,",
         "children": []
        },
        {
         "type": "lit",
         "num": "f",
         "path": "par_3/ust_3/pkt_1/lit_f",
         "text": "Centrum Unijnych Projektów Transportowych,",
         "children": []
        },
        {
         "type": "lit",
         "num": "g",
         "path": "par_3/ust_3/pkt_1/lit_g",
         "text": "Narodowego Centrum Badań i Rozwoju;",
         "children": []
        }
       ]
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_3/ust_3/pkt_2",
       "text": "osoby, których wiedza jest przydatna do realizacji zadań Rady;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_3/ust_3/pkt_3",
       "text": "przedstawicieli organizacji zrzeszających samorządy innych niż określone w ust. 2.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "4",
     "path": "par_3/ust_4",
     "text": "Członkowie Rady, o których mowa w ust. 1 pkt 3 lit. b–d, mogą być zastępowani w pracach Rady przez upoważnionych przedstawicieli w randze sekretarza stanu albo podsekretarza stanu.",
     "children": []
    },
    {
     "type": "ust",
     "num": "5",
     "path": "par_3/ust_5",
     "text": "W przypadku gdy minister kieruje więcej niż jednym działem administracji rządowej, o którym mowa w ust. 1 pkt 3 lit. b–d, do zastępowania w pracach Rady wyznacza upoważnionego przedstawiciela w zakresie każdego kierowanego działu.",
     "children": []
    },
    {
     "type": "ust",
     "num": "6",
     "path": "par_3/ust_6",
     "text": "Przedstawiciel, o którym mowa w ust. 2, uzyskuje status członka Rady po wyrażeniu zgody na udział w jej pracach.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "4",
   "path": "par_4",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_4/ust_1",
     "text": "Rada podejmuje rozstrzygnięcia w formie uchwał.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_4/ust_2",
     "text": "Uchwały podejmowane są zwykłą większością głosów, w obecności co najmniej połowy liczby członków Rady. W przypadku równej liczby głosów rozstrzyga głos przewodniczącego Rady.",
     "children": []
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_4/ust_3",
     "text": "Każdy członek Rady dysponuje jednym głosem. W przypadku gdy minister kieruje więcej niż jednym działem administracji rządowej, o którym mowa w § 3 ust. 1 pkt 3 lit. b–d, dysponuje jednym głosem dla każdego kierowanego działu.",
     "children": []
    },
    {
     "type": "ust",
     "num": "4",
     "path": "par_4/ust_4",
     "text": "W ramach dyskusji podczas posiedzenia przewodniczący Rady, zastępca przewodniczącego Rady oraz pozostali członkowie Rady lub ich przedstawiciele mogą zgłaszać poprawki do projektu uchwały.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "5",
   "path": "par_5",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_5/ust_1",
     "text": "Przewodniczący Rady w szczególności:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_5/ust_1/pkt_1",
       "text": "zwołuje posiedzenia Rady;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_5/ust_1/pkt_2",
       "text": "ustala programy posiedzeń Rady;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_5/ust_1/pkt_3",
       "text": "przewodniczy posiedzeniom Rady;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_5/ust_1/pkt_4",
       "text": "przedstawia do akceptacji Rady plan implementacji KPM 2030 oraz propozycje jego aktualizacji;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "par_5/ust_1/pkt_5",
       "text": "występuje do członków Rady o przedstawienie materiałów, dokumentów, wyjaśnień w zakresie niezbędnym do oceny zgodności podejmowanych działań z zadaniami określonymi w planie implementacji;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "6",
       "path": "par_5/ust_1/pkt_6",
       "text": "przedstawia Radzie Ministrów informację z prac Rady.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_5/ust_2",
     "text": "W przypadku nieobecności przewodniczącego Rady jego zadania wykonuje zastępca przewodniczącego Rady.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "6",
   "path": "par_6",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_6/ust_1",
     "text": "Przewodniczący Rady zwołuje posiedzenie Rady co najmniej raz w roku.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_6/ust_2",
     "text": "Na pisemny wniosek co najmniej piętnastu członków Rady mogą być zwoływane dodatkowe posiedzenia Rady.",
     "children": []
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_6/ust_3",
     "text": "W szczególnie uzasadnionych przypadkach przewodniczący Rady może zdecydować o odbyciu posiedzenia Rady przy użyciu środków komunikacji elektronicznej, co obejmuje w szczególności:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_6/ust_3/pkt_1",
       "text": "transmisję posiedzenia w czasie rzeczywistym między uczestnikami posiedzenia Rady,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_6/ust_3/pkt_2",
       "text": "wielostronną komunikację w czasie rzeczywistym, w ramach której uczestnicy posiedzenia Rady mogą wypowiadać się w toku posiedzenia",
       "children": []
      },
      {
       "type": "text",
       "text": "– z zachowaniem niezbędnych zasad bezpieczeństwa."
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "7",
   "path": "par_7",
   "text": "",
   "children": [
    {
     "type": "ust",
     "num": "1",
     "path": "par_7/ust_1",
     "text": "W celu realizacji zadań Rady przewodniczący Rady powołuje zespoły robocze.",
     "children": []
    },
    {
     "type": "ust",
     "num": "2",
     "path": "par_7/ust_2",
     "text": "W pracach zespołów roboczych uczestniczą reprezentanci urzędów lub instytucji wskazani przez członków Rady lub ich przedstawicieli, o których mowa w § 3 ust. 1–3.",
     "children": []
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_7/ust_3",
     "text": "Przewodniczący Rady wyznacza przewodniczących zespołów roboczych.",
     "children": []
    },
    {
     "type": "ust",
     "num": "4",
     "path": "par_7/ust_4",
     "text": "Przewodniczący zespołów roboczych są odpowiedzialni za organizację pracy zespołów roboczych, w szczególności za przedłożenie materiałów przewodniczącemu Rady celem przedyskutowania i rozstrzygnięcia przez Radę.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "8",
   "path": "par_8",
   "text": "Obsługę Rady zapewnia urząd obsługujący Ministra.",
   "children": []
  },
  {
   "type": "par",
   "num": "9",
   "path": "par_9",
   "text": "Udział w pracach Rady jest nieodpłatny.",
   "children": []
  },
  {
   "type": "par",
   "num": "10",
   "path": "par_10",
   "text": "Organy administracji rządowej oraz podległe im jednostki organizacyjne, w zakresie określonym w § 2, współdziałają z Radą oraz udzielają wsparcia przy realizacji jej zadań.",
   "children": []
  },
  {
   "type": "par",
   "num": "11",
   "path": "par_11",
   "text": "Zarządzenie wchodzi w życie z dniem następującym po dniu ogłoszenia.",
   "children": []
