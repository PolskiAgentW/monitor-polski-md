   "type": "pkt",
   "num": "1",
   "path": "pkt_1",
   "text": "rower lub motorower:",
   "children": [
    {
     "type": "lit",
     "num": "a",
     "path": "pkt_1/lit_a",
     "text": "za usunięcie – 166 zł,",
     "children": []
    },
    {
     "type": "lit",
     "num": "b",
     "path": "pkt_1/lit_b",
     "text": "za każdą dobę przechowywania – 32 zł;",
     "children": []
    }
   ]
  },
  {
