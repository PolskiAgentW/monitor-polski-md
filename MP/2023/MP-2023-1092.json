  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Szczurek Robert Antoni,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz społeczności lokalnej oraz przemian demokratycznych w Polsce:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "18",
   "path": "ust_18",
   "text": "Brant Jerzy,",
   "children": []
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Supernak Zbigniew Tadeusz, ZŁOTYM KRZYŻEM ZASŁUGI za zasługi w działalności na rzecz społeczności lokalnej oraz przemian demokratycznych w Polsce 20. Głodowski Jan Henryk,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz przemian demokratycznych w Polsce 21. Kopeć Lech Lucjan,"
    },
    {
     "type": "text",
     "text": "obywatel Stanów Zjednoczonych Ameryki"
    },
    {
     "type": "text",
     "text": "w uznaniu wybitnych zasług we wspieraniu przemian demokratycznych w Polsce, za działalność na rzecz wstąpienia Polski do NATO"
    },
    {
     "type": "text",
     "text": "KRZYŻEM WIELKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ 22. Muravchik Joshua,"
    },
    {
     "type": "text",
     "text": "na wniosek Wojewody Dolnośląskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz przemian demokratycznych w Polsce"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI 23. Buczek Radosław,"
    },
    {
     "type": "text",
     "text": "na wniosek Wojewody Śląskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz przemian demokratycznych w Polsce"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI 24. Krauz Stanisława Katarzyna,"
    }
   ]
  },
