 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 21 listopada 2022 r. nr rej. 513/2022 o nadaniu orderów",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2023/102/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 21 listopada 2022 r."
  },
  {
   "type": "text",
   "text": "nr rej. 513/2022"
  },
  {
   "type": "text",
   "text": "o nadaniu orderów"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2022 r. poz. 1031) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności na rzecz górnictwa i energetyki, za osiągnięcia w pracy naukowo-badawczej"
  },
  {
   "type": "text",
   "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Kasztelewicz Zbigniew Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju ochrony przeciwpożarowej, za działalność społeczną"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Bartkowiak Andrzej Paweł,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju samorządu terytorialnego, za działalność społeczną i publiczną"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Karlak Antoni,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w pracy naukowo-badawczej w dziedzinie historii wojskowości"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Kwaśniewicz Włodzimierz Janusz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Prezesa Rady Ministrów"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju międzynarodowej współpracy na rzecz ochrony życia i zdrowia oraz niesienia pomocy humanitarnej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Butkiewicz Sławomir Karol,",
   "children": []
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Hampel Michał Andrzej,",
   "children": []
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Korpowski Konrad Paweł,",
   "children": []
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Marchlewicz Mariusz Henryk.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
