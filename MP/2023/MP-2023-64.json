   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 19 grudnia 2022 r."
  },
  {
   "type": "text",
   "text": "nr 1130.93.2022"
  },
  {
   "type": "text",
   "text": "o powołaniu do pełnienia urzędu na stanowisku sędziego"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 179 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r., na wniosek Krajowej Rady Sądownictwa, powołuję niżej wymienione osoby do pełnienia urzędu:"
  },
  {
   "type": "text",
   "text": "na stanowisku sędziego Sądu Okręgowego:"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Joanna Magdalena Dębała-Strzelak – w Radomiu,",
   "children": []
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Stanisław Dziurlikowski – w Toruniu,",
   "children": []
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Magdalena Katarzyna Rubys – w Bielsku-Białej,",
   "children": [
    {
     "type": "text",
     "text": "na stanowisku sędziego Sądu Rejonowego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Krzysztof Strękowski – w Głogowie,",
   "children": [
    {
     "type": "text",
     "text": "na stanowisku sędziego Wojskowego Sądu Garnizonowego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Radosław Bogumił Chamionek – w Szczecinie.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
