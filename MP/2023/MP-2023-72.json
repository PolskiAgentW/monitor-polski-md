 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 21 grudnia 2022 r."
  },
  {
   "type": "text",
   "text": "nr 1130.100.2022"
  },
  {
   "type": "text",
   "text": "o powołaniu do pełnienia urzędu na stanowisku sędziego"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 179 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r., na wniosek Krajowej Rady Sądownictwa, powołuję niżej wymienione osoby do pełnienia urzędu: na stanowisku sędziego Sądu Najwyższego:"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Dariusz Andrzej Pawłyszcze, na stanowisku sędziego Sądu Apelacyjnego:",
   "children": []
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Dariusz Józef Drajewicz – w Warszawie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Waldemar Grzegorz Krok – w Rzeszowie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Dorota Małgorzata Mazurek – w Szczecinie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Anna Olszewska – w Krakowie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Rafał Puchalski – w Rzeszowie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Jacek Jan Saramaga – we Wrocławiu, na stanowisku sędziego Sądu Okręgowego:",
   "children": []
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Joanna Kołodziej-Michałowicz – w Słupsku,",
   "children": []
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Krzysztof Szafrański – w Słupsku, na stanowisku sędziego Sądu Rejonowego:",
   "children": []
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Sylwia Plago-Kaczmarek – w Elblągu,",
   "children": []
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Agata Natalia Tront-Grzesiak – w Żaganiu.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
