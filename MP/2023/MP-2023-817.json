  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Szymon Śniady – dla Łodzi-Widzewa w Łodzi,",
   "children": []
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Bartłomiej Michał Świątkowski – dla Łodzi-Śródmieścia w Łodzi,",
