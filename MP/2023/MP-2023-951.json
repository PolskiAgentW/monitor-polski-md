   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 14 sierpnia 2023 r."
  },
  {
   "type": "text",
   "text": "nr 1130.52.2023"
  },
  {
   "type": "text",
   "text": "o powołaniu do pełnienia urzędu na stanowisku sędziego"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 179 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r., na wniosek Krajowej Rady Sądownictwa, powołuję niżej wymienione osoby do pełnienia urzędu:"
  },
  {
   "type": "text",
   "text": "na stanowisku sędziego Sądu Okręgowego:"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Monika Chmielewska – w Warszawie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Agnieszka Ewa Leszczyńska-Rydlewska – w Bydgoszczy,",
   "children": [
    {
     "type": "text",
     "text": "na stanowisku sędziego Sądu Rejonowego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Marcin Edward Orzechowski – dla Warszawy-Woli w Warszawie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Piotr Przygoda – dla Warszawy-Woli w Warszawie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Rafał Radłowski – w Gliwicach,",
   "children": []
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Grzegorz Marek Sobolak – dla Warszawy-Woli w Warszawie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Katarzyna Solarczyk – w Mogilnie.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
