 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 4 października 2022 r. nr rej. 450/2022 o nadaniu orderów i odznaczenia",
 "converter": "eli2md 0.6.25.2",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2023/16/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 4 października 2022 r."
  },
  {
   "type": "text",
   "text": "nr rej. 450/2022"
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczenia"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2022 r. poz. 1031) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w pracy naukowo-badawczej i dydaktycznej, za popularyzowanie polskiej myśli naukowej na świecie:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Skubisz Ryszard Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Franaszek Piotr Stanisław,",
   "children": []
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Kotarba Andrzej Janusz,",
   "children": []
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Kuźmicz Wiesław Bohdan,",
   "children": []
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Malec Edward Janusz,",
   "children": []
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Oleś Andrzej Michał,",
   "children": []
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Ostrowski Michał Aleksander,",
   "children": []
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Ożóg Krzysztof Józef,",
   "children": []
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Sojka Zbigniew,",
   "children": []
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Stochel Grażyna Jolanta,",
   "children": []
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Surdacki Marian,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju językoznawstwa, za pracę naukowo-badawczą i dydaktyczną"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Kąś Józef,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i charytatywnej na rzecz osób potrzebujących pomocy oraz wsparcia"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Kurek Beata Katarzyna.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
