   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 27 kwietnia 2023 r."
  },
  {
   "type": "text",
   "text": "nr 1130.30.2023"
  },
  {
   "type": "text",
   "text": "o powołaniu do pełnienia urzędu na stanowisku sędziego"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 179 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r., na wniosek Krajowej Rady Sądownictwa, powołuję niżej wymienione osoby do pełnienia urzędu:"
  },
  {
   "type": "text",
   "text": "na stanowisku sędziego Sądu Okręgowego:"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Dorota Baran – w Kielcach,",
   "children": [
    {
     "type": "text",
     "text": "na stanowisku sędziego Sądu Rejonowego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Anna Banaszkiewicz – w Ostródzie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Michał Paweł Nizioł – w Jaworznie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Katarzyna Maria Słuszniak-Marciniak – dla Warszawy-Mokotowa w Warszawie.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
