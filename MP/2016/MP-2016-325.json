{
 "eli": "MP/2016/325",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 3 lutego 2016 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.7",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2016/325/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 41/2016"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 3 lutego 2016 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2015 r. poz. 475 i 1266), na wniosek Wojewody Małopolskiego, odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "text",
   "text": "za zasługi w działalności na rzecz rozwoju transportu"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Sieńko Stanisław Marcin,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Janusz Halina, 3. Pyka Małgorzata,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania sportu"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Obora Stanisław Feliks,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Wacławik Józef,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Kolasa Paweł Marian,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania turystyki:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Hubicki Krzysztof Roman, 8. Jędrocha Anna Ewa,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Posadzki Józef, 10. Wesołowska Marta Maria, za zasługi w działalności na rzecz rozwoju i upowszechniania pszczelarstwa",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Flaga Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz upowszechniania historii pożarnictwa"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Bazela Henryk,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i charytatywnej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Osiniak Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w popularyzowaniu i upowszechnianiu tradycji ludowych"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Majerczyk Dorota Izabela.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
