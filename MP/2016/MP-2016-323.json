 "eli": "MP/2016/323",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 3 lutego 2016 r. o nadaniu orderów",
 "converter": "eli2md 0.6.25",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2016/323/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 16/2016"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 3 lutego 2016 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2015 r. poz. 475 i 1266) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności na rzecz rozwoju i upowszechniania sportu:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Kobendza Ryszard Lucjan,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Ryszewska Edyta Maria,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju rolnictwa:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Pospieszny Henryk,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Korbas Marek, 5. Mrówczyński Marek Ludwik,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności społecznej na rzecz środowisk kombatanckich i polonijnych"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Posorski Jerzy.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
