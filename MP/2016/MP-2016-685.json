   "text": "ZARZĄDZENIE NR 93"
  },
  {
   "type": "text",
   "text": "PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 13 lipca 2016 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Kultury i Dziedzictwa Narodowego"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2012 r. poz. 392 oraz z 2015 r. poz. 1064) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Kultury i Dziedzictwa Narodowego nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 69 Prezesa Rady Ministrów z dnia 15 września 2010 r. w sprawie nadania statutu Ministerstwu Kultury i Dziedzictwa Narodowego (M.P. poz. 847).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie z dniem następującym po dniu ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: B. Szydło"
  }
 ],
