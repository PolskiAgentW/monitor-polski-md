   "text": "ZARZĄDZENIE NR 31"
  },
  {
   "type": "text",
   "text": "PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 9 marca 2016 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Edukacji Narodowej"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2012 r. poz. 392 oraz z 2015 r. poz. 1064) zarz ą dza si ę , co nast ę puje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Edukacji Narodowej nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 5 Prezesa Rady Ministrów z dnia 30 stycznia 2013 r. w sprawie nadania statutu Ministerstwu Edukacji Narodowej (M.P. poz. 48).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie z dniem następującym po dniu ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: B. Szydło"
  }
 ],
