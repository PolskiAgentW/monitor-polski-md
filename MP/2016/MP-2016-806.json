 "eli": "MP/2016/806",
 "title": "Obwieszczenie Ministra Finansów z dnia 10 sierpnia 2016 r. w sprawie ogłoszenia rejestru aktuariuszy",
 "converter": "eli2md 0.6.25",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2016/806/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "OBWIESZCZENIE"
  },
  {
   "type": "text",
   "text": "MINISTRA FINANSÓW[^1]"
  },
  {
   "type": "text",
   "text": "z dnia 10 sierpnia 2016 r."
  },
  {
   "type": "text",
   "text": "w sprawie ogłoszenia rejestru aktuariuszy"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 68 ust. 9 ustawy z dnia 11 września 2015 r. o działalności ubezpieczeniowej i reasekuracyjnej (Dz. U. poz. 1844 oraz z 2016 r. poz. 615) ogłasza się rejestr aktuariuszy, według stanu na dzień 17 lipca 2016 r., stanowiący załącznik do obwieszczenia."
  },
  {
   "type": "signature",
   "text": "Minister Finansów: P. Szałamacha"
  }
 ],
