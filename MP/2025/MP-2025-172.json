   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Dyrkacz Wojciech Tadeusz,",
   "children": []
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Łopuszyński Stanisław,",
   "children": []
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Rogoziński Marcin,",
   "children": []
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Zimny Sebastian Wieńczysław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Spraw Wewnętrznych i Administracji"
    },
    {
     "type": "text",
     "text": "za czyny spełnione w specjalnie ciężkich warunkach, z wykazaniem wyjątkowej odwagi, z narażeniem życia lub zdrowia:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM ZASŁUGI ZA DZIELNOŚĆ po raz drugi"
    }
   ]
  },
