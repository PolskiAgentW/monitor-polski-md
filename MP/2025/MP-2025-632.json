   "type": "ust",
   "num": "36",
   "path": "ust_36",
   "text": "Partyka Karol Robert,",
   "children": []
  },
  {
   "type": "ust",
   "num": "37",
   "path": "ust_37",
   "text": "Puła Dawid Władysław,",
   "children": []
  },
  {
   "type": "ust",
   "num": "38",
   "path": "ust_38",
   "text": "Wiśniewski Rafał Marcin, za zasługi w działalności społecznej na rzecz mniejszości ormiańskiej w Polsce i budowania relacji polsko-ormiańskich",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "39",
   "path": "ust_39",
   "text": "Bojadżjan Hraczja,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Świętokrzyskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "40",
   "path": "ust_40",
   "text": "Buda Mariusz Krzysztof,",
   "children": []
  },
  {
   "type": "ust",
   "num": "41",
   "path": "ust_41",
