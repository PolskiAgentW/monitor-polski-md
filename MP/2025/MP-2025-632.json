    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI 25. Cempura Grzegorz Jacek,"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI 26. Baran Robert Marek,"
