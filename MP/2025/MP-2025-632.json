  },
  {
   "type": "ust",
   "num": "27",
   "path": "ust_27",
   "text": "Bieniek Tadeusz Zygmunt,",
   "children": []
  },
  {
   "type": "ust",
   "num": "28",
   "path": "ust_28",
   "text": "Ujma-Wąsowicz Katarzyna,",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI za zasługi w działalności na rzecz ochrony zdrowia 29. Jasiński Andrzej Stanisław, za zasługi w działalności społecznej, kulturalnej oraz edukacyjnej 30. Nizioł Monika Katarzyna, za ofiarne niesienie pomocy drugiemu człowiekowi oraz poświęcenie w ratowaniu zdrowia i życia ludzkiego"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI pośmiertnie:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "Dudek Piotr Paweł,",
   "children": []
  },
  {
