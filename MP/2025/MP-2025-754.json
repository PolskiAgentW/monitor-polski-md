 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 5 lutego 2025 r."
  },
  {
   "type": "text",
   "text": "nr 1130.1.2025"
  },
  {
   "type": "text",
   "text": "o powołaniu do pełnienia urzędu na stanowisku sędziego"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 179 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r., na wniosek Krajowej Rady Sądownictwa, powołuję niżej wymienione osoby do pełnienia urzędu:"
  },
  {
   "type": "text",
   "text": "na stanowisku sędziego Naczelnego Sądu Administracyjnego:"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Wojciech Maciejko,",
   "children": [
    {
     "type": "text",
     "text": "na stanowisku sędziego Sądu Apelacyjnego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Kinga Urszula Kubuj – w Warszawie,",
   "children": [
    {
     "type": "text",
     "text": "na stanowisku sędziego Sądu Rejonowego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Bartłomiej Balcerek – dla Warszawy-Śródmieścia w Warszawie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Katarzyna Gontarz – dla Krakowa-Nowej Huty w Krakowie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Łukasz Jan Jamroży – w Będzinie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Patrycja Eliza Kończyk-Chorab – w Tarnobrzegu,",
   "children": []
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Zina Justyna Kroczek-Sawicka – w Żyrardowie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Karolina Pawlik – w Lęborku,",
   "children": []
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Joanna Truchel – w Wołominie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Anna Maria Wojtas – w Kłodzku.",
   "children": []
  },
  {
