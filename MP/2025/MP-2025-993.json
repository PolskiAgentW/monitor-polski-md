{
 "eli": "MP/2025/993",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 31 lipca 2025 r. nr rej. 553/2025 o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.2",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2025/993/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 31 lipca 2025 r."
  },
  {
   "type": "text",
   "text": "nr rej. 553/2025"
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2023 r. poz. 2053) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi dla rozwoju nauk prawnych, za osiągnięcia w działalności organizacyjnej"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "ks. Dębiński Antoni,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju międzynarodowej współpracy na rzecz ochrony zdrowia, za osiągnięcia w pracy naukowo-badawczej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Gajewski Piotr Mieczysław,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności państwowej i publicznej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Nowak Piotr,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla umacniania suwerenności i obronności kraju"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "kmdr Wypijewski Jarosław Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "za osiągnięcia w dokumentowaniu życia politycznego i społecznego"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Hrechorowicz Andrzej Jan,",
   "children": []
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Szymczuk Jakub Robert.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
