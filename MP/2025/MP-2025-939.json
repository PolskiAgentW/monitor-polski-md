   "text": "Klimek Klaudia Małgorzata,",
   "children": []
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Rotsztejn Aleksander,",
   "children": []
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Sobańska-Klekowska Izabela.",
