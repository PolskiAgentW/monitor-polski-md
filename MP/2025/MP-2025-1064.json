  {
   "type": "text",
   "text": "ZARZĄDZENIE NR 55"
  },
  {
   "type": "text",
   "text": "PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 8 października 2025 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Rolnictwa i Rozwoju Wsi"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2025 r. poz. 780) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Rolnictwa i Rozwoju Wsi nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 30 Prezesa Rady Ministrów z dnia 8 kwietnia 2021 r. w sprawie nadania statutu Ministerstwu Rolnictwa i Rozwoju Wsi (M.P. z 2023 r. poz. 544).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie po upływie 7 dni od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: D. Tusk"
  }
 ],
