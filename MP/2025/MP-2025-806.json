{
 "eli": "MP/2025/806",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 24 czerwca 2025 r. nr rej. 381/2025 o nadaniu orderów i odznaczenia",
 "converter": "eli2md 0.6.3",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2025/806/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 24 czerwca 2025 r."
  },
  {
   "type": "text",
   "text": "nr rej. 381/2025"
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczenia"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2023 r. poz. 2053) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne osiągnięcia w podejmowanej z pożytkiem dla kraju działalności państwowej i publicznej, za zasługi w pracy naukowo-badawczej, dydaktycznej i społecznej:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Szlachta Bogdan Witold,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Nalaskowski Aleksander Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz rozwoju przedsiębiorczości i gospodarki narodowej:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Podrecka Małgorzata Agnieszka,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Agatowska Aleksandra,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne osiągnięcia w pracy duszpasterskiej, za szczególne osiągnięcia w pracy naukowo-badawczej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "ks. Janiga Waldemar Jan,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz popularyzacji i rozwoju nauki w Polsce"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Karaś Roman Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne osiągnięcia w pracy duszpasterskiej, za zasługi w działalności charytatywnej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "ks. Stryczek Jacek Antoni,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w podejmowanej z pożytkiem dla kraju działalności zawodowej i społecznej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Błaszczyk Izabela Ewa.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
