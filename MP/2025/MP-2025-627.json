 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 9 maja 2025 r. nr rej. 262/2025 o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.3",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2025/627/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 9 maja 2025 r."
  },
  {
   "type": "text",
   "text": "nr rej. 262/2025"
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2023 r. poz. 2053) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności na rzecz rozwoju kultury i sztuki"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Malczak Antoni,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz osób niepełnosprawnych oraz potrzebujących pomocy i wsparcia, zagrożonych wykluczeniem społecznym"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Obiegły Irena,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla kultury polskiej, za osiągnięcia w działalności artystycznej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Walewska Małgorzata,",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i charytatywnej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Kołdras Henryk,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Ludwa Wacław Bartłomiej,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Miketa Jacek Władysław,",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju kultury i sztuki"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Olech Liliana,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności misyjnej, duszpasterskiej i społecznej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "o. Wajda Ryszard.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
