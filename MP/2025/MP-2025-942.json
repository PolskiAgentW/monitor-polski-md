  {
   "type": "ust",
   "num": "44",
   "path": "ust_44",
   "text": "Ogrodziński Józef,",
   "children": []
  },
  {
   "type": "ust",
   "num": "45",
   "path": "ust_45",
   "text": "Pawłowski Sławomir, za zasługi w działalności społecznej, za wkład w rozwój budownictwa",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI 46. Staszak Renata, na wniosek Wojewody Lubelskiego: za zasługi w działalności na rzecz zachowania dziedzictwa kulturowego oraz upowszechniania tradycji ludowych:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI 47. Cielińska Małgorzata,"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI 48. Bartoś Wanda,"
    }
   ]
  },
  {
   "type": "ust",
   "num": "49",
   "path": "ust_49",
   "text": "Kluziak Mirosława Teresa,",
   "children": []
  },
  {
   "type": "ust",
   "num": "50",
