   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz duszpasterstwa ludzi pracy, za kultywowanie pamięci ks. Jerzego Popiełuszki"
    }
   ]
  },
  {
   "type": "ust",
   "num": "16",
