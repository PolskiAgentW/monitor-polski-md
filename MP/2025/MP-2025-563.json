  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Wójcicki Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz środowisk związkowych, za upamiętnianie roli duchowieństwa we wspieraniu przemian demokratycznych w Polsce"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "ks. Kowalski Ludwik Jerzy, ZŁOTYM KRZYŻEM ZASŁUGI",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w propagowaniu myśli, nauczania i dziedzictwa św. Jana Pawła II, za działalność na rzecz środowisk związkowych"
    }
   ]
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
