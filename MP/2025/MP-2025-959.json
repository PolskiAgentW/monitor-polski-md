 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 11 lipca 2025 r. nr rej. 474/2025 o nadaniu orderów i odznaczenia",
 "converter": "eli2md 0.6.2",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2025/959/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 11 lipca 2025 r."
  },
  {
   "type": "text",
   "text": "nr rej. 474/2025"
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczenia"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2023 r. poz. 2053) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w rozwijaniu międzynarodowej współpracy, za działalność na rzecz ruchów niepodległościowych w Europie Środkowej:"
  },
  {
   "type": "text",
   "text": "obywatele Węgier:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Molnar Imre,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Hörcsik Richárd,",
   "children": [
    {
     "type": "text",
     "text": "obywatele Republiki Czeskiej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Kubišová Marta,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Tomský Alexander,",
   "children": [
    {
     "type": "text",
     "text": "obywatele Republiki Słowackiej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Figel Jan,",
   "children": []
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Hudacký Ján,",
   "children": []
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Macala Pavol,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w umacnianiu relacji polsko-węgierskich"
    },
    {
     "type": "text",
     "text": "obywatel Rzeczypospolitej Polskiej i Węgier"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "o. Cebula Paweł.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
