 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 16 czerwca 2025 r."
  },
  {
   "type": "text",
   "text": "nr rej. 375/2025"
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczenia"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2023 r. poz. 2053) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w promowaniu Polski, za działalność na rzecz społeczności polskiej za granicą:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "o. Gieniusz Andrzej Marek,",
   "children": []
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "ks. Lasak Józef Franciszek,",
   "children": []
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "ks. bp Nykiel Krzysztof Józef,",
   "children": []
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "o. Wadach Roman,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "ks. Sycz Adam,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w promowaniu Polski, za działalność na rzecz społeczności polskiej za granicą"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Kühne Dagmara Ewa.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
