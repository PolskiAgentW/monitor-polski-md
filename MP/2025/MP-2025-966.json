{
 "eli": "MP/2025/966",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 16 lipca 2025 r. nr rej. 487/2025 o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.2",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2025/966/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 16 lipca 2025 r."
  },
  {
   "type": "text",
   "text": "nr rej. 487/2025"
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2023 r. poz. 2053) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi dla rozwoju medycyny i ochrony zdrowia, za działalność społeczną"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Bichalski Wojciech Roman,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju gospodarki narodowej, za zasługi w działalności państwowej i publicznej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Janczyk Wiesław Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne osiągnięcia w działalności publicznej i społecznej, za osiągnięcia w upamiętnianiu prawdy o najnowszej historii Polski:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Konrad Dobrochna Kazimiera,",
   "children": []
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Peczkis Grzegorz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi na rzecz upowszechniania i popularyzowania kultury polskiej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Goik Łukasz Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w dokumentowaniu i upamiętnianiu prawdy o najnowszej historii Polski"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Dobrowolska Zofia,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Brzozowska Iwona Anna.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
