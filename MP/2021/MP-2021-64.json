 "body": [
  {
   "type": "text",
   "text": "Rej. 400/2020"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 8 października 2020 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2020 r. poz. 138) za zasługi w ratowaniu życia ludzkiego odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Spraw Wewnętrznych i Administracji:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM ZASŁUGI ZA DZIELNOŚĆ"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Kędzierski Kamil Michał, 2. Polański Michał Leszek,",
   "children": [
    {
     "type": "text",
     "text": "MEDALEM ZA OFIARNOŚĆ I ODWAGĘ"
    },
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "st. sierż. Szpyruk Marcin,",
   "children": [
    {
     "type": "text",
     "text": "MEDALEM ZA OFIARNOŚĆ I ODWAGĘ"
    },
    {
     "type": "text",
     "text": "na wniosek Ministra Spraw Zagranicznych:"
    },
    {
     "type": "text",
     "text": "obywatel Republiki Francuskiej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Klein Philippe,",
   "children": [
    {
     "type": "text",
     "text": "obywatel Republiki Słowackiej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Malina Martin,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Dolnośląskiego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Kocenda Tomasz Paweł, 7. Lupa Kamil,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Świętokrzyskiego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Ziabicki Adrian Piotr,",
   "children": [
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Misiura Szymon Jan.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
