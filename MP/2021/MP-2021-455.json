 "body": [
  {
   "type": "text",
   "text": "Rej. 88/2021"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 26 marca 2021 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2020 r. poz. 138) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Klimatu i Środowiska"
  },
  {
   "type": "text",
   "text": "za zasługi w działalności na rzecz rozwoju energetyki w Polsce"
  },
  {
   "type": "text",
   "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Bańko Mirosław, 2. Strojny Piotr Mateusz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Lubelskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przyrody"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Chwedaczuk Marek Jacek,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Małopolskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Janas Marcin Piotr, 5. Multarzyński Tomasz Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Opolskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i duszpasterskiej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "ks. Krzyżanowski Sebastian Dominik,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podkarpackiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    },
    {
     "type": "text",
