 "body": [
  {
   "type": "text",
   "text": "UCHWAŁA NR 5"
  },
  {
   "type": "text",
   "text": "RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 5 stycznia 2021 r."
  },
  {
   "type": "text",
   "text": "w sprawie wyrażenia zgody na przekazanie Komisji Europejskiej dokumentu „Lista zmian w sieci obszarów Natura 2000”"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 27 ust. 3 ustawy z dnia 16 kwietnia 2004 r. o ochronie przyrody (Dz. U. z 2020 r. poz. 55, 471 i 1378) Rada Ministrów uchwala, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Rada Ministrów wyraża zgodę na przekazanie Komisji Europejskiej dokumentu „Lista zmian w sieci obszarów Natura 2000”, stanowiącego załącznik do uchwały.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Uchwała wchodzi w życie z dniem następującym po dniu ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: M. Morawiecki"
  }
 ],
