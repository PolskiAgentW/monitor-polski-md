    {
     "type": "text",
     "text": "na wniosek Ministra Klimatu i Środowiska"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i związkowej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
