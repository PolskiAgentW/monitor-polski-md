 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 5 lutego 2021 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.25.1",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2021/353/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 51/2021"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 5 lutego 2021 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2020 r. poz. 138) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi dla niepodległości Rzeczypospolitej Polskiej:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Hajduczek Edward,",
   "children": [
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Chyliński Tadeusz, 3. Izdebski Aleksander, 4. Silezin Wawrzyniec,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Rakowski Witold,",
   "children": [
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Renke Wiesław Ignacy, 7. Stanecki Zbigniew Cezariusz,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi dla niepodległości Rzeczypospolitej Polskiej, za działalność społeczno-kombatancką"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Karpowicz Piotr,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w pielęgnowaniu pamięci o najnowszej historii Polski"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Kulińska-Rembielińska Barbara Maria,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Szefa Urzędu do Spraw Kombatantów i Osób Represjonowanych"
    },
    {
     "type": "text",
     "text": "za zasługi dla niepodległości Rzeczypospolitej Polskiej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Kolbusz Anna Stanisława, 11. Kowalczyk Jan, 12. Woliński Władysław.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
