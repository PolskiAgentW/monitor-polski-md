   "text": "ZARZĄDZENIE NR 150"
  },
  {
   "type": "text",
   "text": "PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 20 sierpnia 2021 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Rodziny i Polityki Społecznej"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2021 r. poz. 178, 1192 i 1535) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Rodziny i Polityki Społecznej nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 234 Prezesa Rady Ministrów z dnia 4 grudnia 2020 r. w sprawie nadania statutu Ministerstwu Rodziny i Polityki Społecznej (M.P. poz. 1119 oraz z 2021 r. poz. 402).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie z dniem następującym po dniu ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: M. Morawiecki"
  }
 ],
