 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE NR 17"
  },
  {
   "type": "text",
   "text": "PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 26 lutego 2021 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Kultury, Dziedzictwa Narodowego i Sportu"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2021 r. poz. 178) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Kultury, Dziedzictwa Narodowego i Sportu nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Tracą moc:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_2/pkt_1",
     "text": "zarządzenie nr 93 Prezesa Rady Ministrów z dnia 13 lipca 2016 r. w sprawie nadania statutu Ministerstwu Kultury i Dziedzictwa Narodowego (M.P. z 2018 r. poz. 461);",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_2/pkt_2",
     "text": "zarządzenie nr 34 Prezesa Rady Ministrów z dnia 9 marca 2020 r. w sprawie nadania statutu Ministerstwu Sportu (M.P. poz. 258).",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie z dniem 1 marca 2021 r.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: M. Morawiecki"
  }
 ],
 "annexes": [
