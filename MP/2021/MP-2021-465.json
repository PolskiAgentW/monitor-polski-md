{
 "eli": "MP/2021/465",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 24 marca 2021 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2021/465/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 102/2021"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 24 marca 2021 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2020 r. poz. 138), na wniosek Ministra Spraw Zagranicznych, odznaczeni zostają"
  },
  {
   "type": "text",
   "text": "obywatele Bośni i Hercegowiny:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w rozwijaniu współpracy między Rzecząpospolitą Polską a Bośnią i Hercegowiną, za popularyzowanie polskiej kultury"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KAWALERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Šantić Slavko,",
   "children": [
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Mišković Miloš,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności polonijnej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Buganik-Pranjić Marija,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Kovč Danijel.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
