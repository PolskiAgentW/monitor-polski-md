   "type": "text",
   "text": "Rej. 139/2021"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 20 kwietnia 2021 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2020 r. poz. 138), za zasługi w ratowaniu życia ludzkiego, odznaczeni zostają"
  },
  {
   "type": "text",
   "text": "MEDALEM ZA OFIARNOŚĆ I ODWAGĘ"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Spraw Zagranicznych"
  },
  {
   "type": "text",
   "text": "obywatele Stanów Zjednoczonych Ameryki Północnej:"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Olsen Del, 2. Yando Gail,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Małopolskiego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Gil Paweł Antoni, 4. Solecki Dawid Stanisław, 5. Wcisło Robert Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Śląskiego"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Niesłony Adam Piotr.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
