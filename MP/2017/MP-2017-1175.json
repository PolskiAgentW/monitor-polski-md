       "path": "par_1/pkt_1/lit_c",
       "text": "pkt 9 otrzymuje brzmienie:",
       "children": [
        {
         "type": "text",
         "text": "„9) Departament Nadzoru i Polityki Właścicielskiej;”,",
         "quoted": true
        }
       ]
