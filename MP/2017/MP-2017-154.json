     "type": "text",
     "text": "na wniosek Ministra Rolnictwa i Rozwoju Wsi"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju hodowli roślin i nasiennictwa:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
