 "body": [
  {
   "type": "text",
   "text": "Rej. 427/2017"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 1 września 2017 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2015 r. poz. 475 i 1266 oraz z 2016 r. poz. 1948) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Infrastruktury i Budownictwa:"
  },
  {
   "type": "text",
   "text": "za zasługi w działalności społecznej i związkowej"
  },
  {
   "type": "text",
   "text": "SREBRNYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Mering Mariusz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju polskiego transportu kolejowego"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Banaszak Adam,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Kultury i Dziedzictwa Narodowego"
    },
    {
     "type": "text",
     "text": "za zasługi dla kultury polskiej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Adamowicz Jarosław, 4. Badyna Karol, 5. Murzyn Józef,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Bortnik-Morajda Bogusława, 7. Botor Henryk Jan, 8. Korzeniowski Piotr Adam, 9. Krzak Edward, 10. Łaciak Roman, 11. Mencel Joachim Nikodem, 12. Nęcka Monika Bożena, 13. Reinhard-Chlanda Małgorzata, 14. Sękowska Anna, 15. Stelmachniewicz Witold, 16. Szlezer Mieczysław Andrzej, 17. Walczak Małgorzata Luiza, 18. Wawrzusiak-Borcz Mariola,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Bień Mateusz Andrzej, 20. Długosz Magdalena Zofia, 21. Kapela Wojciech, 22. Nosko Marcin, 23. Organisty Adam, 24. Orzechowska Renata Maria, 25. Ozimkowski Jacek Aleksander, 26. Pawłowska-Górska Agnieszka, 27. Pisarski Janusz Tadeusz, 28. Rumin Dorota Joanna, 29. Struzik Bartłomiej, 30. Toborowicz Aleksandra Maria, na wniosek Ministra Rolnictwa i Rozwoju Wsi",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju polskiego rolnictwa"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "Fąfera Beata Ewa, 32. Łuczka Marian Antoni,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Dolnośląskiego"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ratownictwa górniczego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "33",
   "path": "ust_33",
   "text": "Budziłowicz Mariusz, 34. Dereń Waldemar,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz muzealnictwa"
    }
   ]
  },
  {
   "type": "ust",
   "num": "35",
   "path": "ust_35",
   "text": "Hass Waldemar Daniel,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz zachowania pamięci narodowej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "36",
   "path": "ust_36",
   "text": "Siekierka Michał Adam,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Łódzkiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "37",
   "path": "ust_37",
   "text": "ks. Czaja Grzegorz Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Mazowieckiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony zdrowia"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "38",
   "path": "ust_38",
   "text": "Leśkowicz Mirosław, 39. Mitura Kryspin,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "40",
   "path": "ust_40",
   "text": "Nowak Maciej Hubert,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Opolskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "41",
   "path": "ust_41",
   "text": "ks. Robaczek Bolesław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podlaskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "42",
   "path": "ust_42",
   "text": "ks. Żdanuk Tadeusz, SREBRNYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "43",
   "path": "ust_43",
   "text": "Brankiewicz Krzysztof Jan, 44. Kluczyńska Janina, 45. Sofiński Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "46",
   "path": "ust_46",
   "text": "Zawadzki Sylwester,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Śląskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania sportu"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "47",
   "path": "ust_47",
   "text": "Szafraniec Tadeusz Alojzy,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i charytatywnej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "48",
   "path": "ust_48",
   "text": "Grzesiak Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "49",
   "path": "ust_49",
   "text": "Kaczmarek Tadeusz, 50. Szpądrowski Marcin Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "51",
   "path": "ust_51",
   "text": "Gibas Marcin,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Warmińsko-Mazurskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "52",
   "path": "ust_52",
   "text": "Dobradin Lech Andrzej.",
   "children": []
  },
  {
