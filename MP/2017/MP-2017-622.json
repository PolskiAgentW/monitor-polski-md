{
 "eli": "MP/2017/622",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 26 kwietnia 2017 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.7",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2017/622/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 177/2017"
  },
  {
   "type": "text",
   "text": "Postanowienie"
  },
  {
   "type": "text",
   "text": "Prezydenta rzeczyPosPolitej Polskiej"
  },
  {
   "type": "text",
   "text": "z dnia 26 kwietnia 2017 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2015 r. poz. 475 i 1266 oraz z 2016 r. poz. 1948) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w pielęgnowaniu pamięci o najnowszej historii Polski, za działalność kombatancką i społeczną:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Foksa Władysław,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    },
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Poteraj Józef,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Linowski Henryk, 4. Oboron Jerzy, 5. Rakowski Janusz Feliks,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla niepodległości Rzeczypospolitej Polskiej, za działalność kombatancką i społeczną"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Atemborski Henryk Władysław, 7. Michniewicz Marian,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi dla niepodległości Rzeczypospolitej Polskiej:"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Kowalczewski Zdzisław, 9. Szempliński Tadeusz Wiesław,",
   "children": [
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Biegun Antoni, 11. Piechalski Wincenty Anastazy,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Jędrych Jadwiga Aniela, 13. Michalski Witold, 14. Pop Józef, 15. Wieczorek Józef, 16. Żukowska Krystyna Maria, za bohaterską postawę i niezwykłą odwagę wykazaną w ratowaniu życia ludzkiego podczas II wojny światowej",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "s. Reszczyńska Lucja,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w dokumentowaniu i upamiętnianiu prawdy o najnowszej historii Polski"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "18",
   "path": "ust_18",
   "text": "Rebzda Marta,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Spraw Zagranicznych"
    },
    {
     "type": "text",
     "text": "obywatel Rzeczypospolitej Polskiej i Republiki Argentyńskiej"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi dla niepodległości Rzeczypospolitej Polskiej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Żebrowski Antoni,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Szefa Urzędu do Spraw Kombatantów i Osób Represjonowanych"
    },
    {
     "type": "text",
     "text": "za zasługi dla niepodległości Rzeczypospolitej Polskiej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Kosk Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "21",
   "path": "ust_21",
   "text": "Lipka Józef, 22. Sęk Jan, 23. Szyiński Józef.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
