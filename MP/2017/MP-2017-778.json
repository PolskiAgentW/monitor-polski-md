  {
   "type": "ust",
   "num": "39",
   "path": "ust_39",
   "text": "Gralak Jacek,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przyrody oraz popularyzacji wędkarstwa:"
