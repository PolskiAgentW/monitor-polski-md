 "body": [
  {
   "type": "text",
   "text": "Postanowienie nr rej. 104/2017"
  },
  {
   "type": "text",
   "text": "Prezydenta rzeczyPosPolitej Polskiej"
  },
  {
   "type": "text",
   "text": "z dnia 23 marca 2017 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2015 r. poz. 475 i 1266 oraz z 2016 r. poz. 1948) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Rozwoju"
  },
  {
   "type": "text",
   "text": "za zasługi w działalności na rzecz rozwoju gospodarki:"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Babul Tomasz,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Wojciechowski Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Sportu i Turystyki"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i popularyzacji turystyki"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Barańska Wilhelma Zdzisława, 4. Brosz Ewa, 5. Chądziński Dariusz Piotr,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Szefa Urzędu do Spraw Kombatantów i Osób Represjonowanych"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz organizacji kombatanckich"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Grynia Marianna,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Małopolskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Cebula Adam Stanisław, 8. Leś Edmund,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Augustyński Stanisław, 10. Drozd Helena, 11. Drozd Lesław, 12. Franczak Stanisław, 13. Goryl Ludwina, 14. Kijowski Kamil, 15. Kułak Jan, 16. Kura Piotr Stanisław, 17. Ludkowski Adam Stanisław, 18. Przeklasa Janusz Ryszard, 19. Serwatka Zbigniew Józef, 20. Szczurek Mieczysław, 21. Śmietana Marek Paweł, 22. Świerad Wacław Władysław, 23. Tlałka Jacek Piotr, 24. Tomolik Edward, SREBRNYM KRZYŻEM ZASŁUGI",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "25",
   "path": "ust_25",
   "text": "Grochal Maria, 26. Hanarz Jerzy Marian,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i związkowej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "27",
   "path": "ust_27",
   "text": "Sikorski Janusz Czesław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podlaskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i związkowej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "28",
   "path": "ust_28",
   "text": "Kaczyńska Danuta Maria,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Pomorskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz upamiętniania i kultywowania historii polskiego oręża:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "29",
   "path": "ust_29",
   "text": "Landowski Krzysztof, 30. Popławski Mariusz,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "Papieczka Jerzy, 32. Tobieński Jarosław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz upowszechniania turystyki i krajoznawstwa:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "33",
   "path": "ust_33",
   "text": "Lewicki Jan Antoni, 34. Strojny Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "35",
   "path": "ust_35",
   "text": "Betcher Ryszard,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "36",
   "path": "ust_36",
   "text": "Oskarbski Grzegorz Marcin,",
   "children": [
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "37",
   "path": "ust_37",
   "text": "Strojny Krzysztof,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i charytatywnej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "38",
   "path": "ust_38",
   "text": "Wróbel Elżbieta Weronika.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
