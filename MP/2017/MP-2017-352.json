{
 "eli": "MP/2017/352",
 "title": "Postanowienie nr rej. 60/2017 Prezydenta Rzeczypospolitej Polskiej z dnia 10 lutego 2017 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.7",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2017/352/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE NR REJ. 60/2017"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 10 lutego 2017 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2015 r. poz. 475 i 1266 oraz z 2016 r. poz. 1948) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Kultury i Dziedzictwa Narodowego"
  },
  {
   "type": "text",
   "text": "za zasługi dla kultury polskiej, za osiągnięcia artystyczne"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Piskorz Leszek,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Rolnictwa i Rozwoju Wsi:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju badań naukowych oraz wdrożeniowych w dziedzinie ochrony roślin:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Łozowicka Bożena,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Olejarski Paweł Roman,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i promowania pszczelarstwa:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Tryzna Wojciech,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Dudziński Wacław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Lubuskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi dla kultury polskiej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Polus Anna, za zasługi w działalności na rzecz osób potrzebujących pomocy oraz wsparcia",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Mielcarek Zofia, 8. Szymańska Joanna,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Łódzkiego"
    },
    {
     "type": "text",
     "text": "za zasługi dla kultury polskiej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Gańczyk Teresa, 10. Nowacka Zofia,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Małopolskiego:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania turystyki krajoznawczej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Czak Robert Andrzej, 12. Lasoń Stefan Bogdan, 13. Pudo Kazimierz Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Kapołka Mateusz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Chodór Stanisław, 16. Chojnacki Witold, 17. Gaweł Marcin Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podkarpackiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "18",
   "path": "ust_18",
   "text": "Kocój Andrzej Tadeusz, 19. Wulw Józef,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Śląskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju medycyny i ochrony zdrowia"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Horák Stanisław, 21. Olejek Anita,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "22",
   "path": "ust_22",
   "text": "Kwiecińska Elżbieta.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
