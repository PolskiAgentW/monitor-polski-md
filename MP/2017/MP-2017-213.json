 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE NR 13"
  },
  {
   "type": "text",
   "text": "PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 21 lutego 2017 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Finansów"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2012 r. poz. 392 oraz z 2015 r. poz. 1064) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Finansów nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 20 Prezesa Rady Ministrów z dnia 22 lutego 2016 r. w sprawie nadania statutu Ministerstwu Finansów (M.P. poz. 185 i 1161 oraz z 2017 r. poz. 164).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie z dniem 24 lutego 2017 r.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: B. Szydło"
  }
 ],
