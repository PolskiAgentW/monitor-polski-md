{
 "eli": "MP/2017/1073",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 24 sierpnia 2017 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.7",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2017/1073/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 412/2017"
  },
  {
   "type": "text",
   "text": "Postanowienie"
  },
  {
   "type": "text",
   "text": "Prezydenta rzeczyPosPolitej Polskiej"
  },
  {
   "type": "text",
   "text": "z dnia 24 sierpnia 2017 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2015 r. poz. 475 i 1266 oraz z 2016 r. poz. 1948) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Spraw Wewnętrznych i Administracji"
  },
  {
   "type": "text",
   "text": "za zasługi w działalności na rzecz Wodnego Ochotniczego Pogotowia Ratunkowego"
  },
  {
   "type": "text",
   "text": "SREBRNYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Murias Radosław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Środowiska"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony środowiska i rozwoju leśnictwa"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Bukowski Stanisław, 3. Chmurski Władysław Henryk, 4. Chłopek Jerzy, 5. Drapała Adam, 6. Kotulski Stanisław, 7. Mazur Jan, 8. Stachurski Bronisław, 9. Tkacz Ewa,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Małopolskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz upamiętniania historii Polski:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Martyna Jadwiga Rozalia,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Sura Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz kształtowania moralności i patriotycznej postawy polskiej młodzieży"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Grabiec Witold, za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej:",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Matura Grzegorz, 14. Matura Paweł,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Dymura Mariusz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podkarpackiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz profilaktyki zdrowotnej oraz ochrony zdrowia:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "16",
   "path": "ust_16",
   "text": "Waszczak Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Hrynkiewicz Lucyna, 18. Kłyż Barbara,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Pomorskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Chwal Bogdan Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Karpinski Zygmunt,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "21",
   "path": "ust_21",
   "text": "Dzwonkowski Tadeusz Adam, 22. Hinca Zenon Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "23",
   "path": "ust_23",
   "text": "Thiel Jacek Wojciech.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
