 "body": [
  {
   "type": "text",
   "text": "Rej. 30/2018"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 5 lutego 2018 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2015 r. poz. 475 i 1266, z 2016 r. poz. 1948, z 2017 r. poz. 2303 oraz z 2018 r. poz. 138) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Kultury i Dziedzictwa Narodowego"
  },
  {
   "type": "text",
   "text": "za zasługi dla kultury polskiej, za osiągnięcia artystyczne"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Iwicki Piotr,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Prezesa Urzędu Ochrony Konkurencji i Konsumentów"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju systemu prawa ochrony polskich konsumentów"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Pluskwa-Dąbrowski Kamil Stanisław, 3. Rokicka Grażyna,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Łódzkiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej, za upowszechnianie historii Polski"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Pawlak Stanisław Stefan, 5. Stolarczyk Tomasz Marcin,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Małopolskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju nauki i gospodarki:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Oboza Kazimierz,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Kudlik Kazimierz Jan, 8. Młynarski Stanisław Jan, 9. Szpytko Janusz Leszek, 10. Zaraska Wiesław Marian, za zasługi oraz osiągnięcia w dziedzinie drogownictwa",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Reszczyk Anna Dorota,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Kulig Marian Adam,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Cionek Józef Leon,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz środowiska inżynierskiego:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Zastawny Maria Danuta,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Michnej Maciej Mateusz, 16. Siara Marek Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju energetyki"
    }
   ]
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Gondek Marian Adam,",
   "children": [
    {
     "type": "text",
     "text": "za osiągnięcia w dziedzinie geodezji i kartografii"
    }
   ]
  },
  {
   "type": "ust",
   "num": "18",
   "path": "ust_18",
   "text": "Marciniak Mirosław Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Ptaszek Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Mazowieckiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Brzozowski Kazimierz Henryk, 21. Chmieliński Adam Zbigniew, 22. Dobrosielski Jan Leopold, 23. Kowalski Andrzej, 24. Kulgawczyk Waldemar Rościsław, 25. Lewandowski Dariusz, 26. Mędrek Dariusz Marcin, 27. Wasilewski Cezary, 28. Zadrożny Ryszard Jan,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "29",
   "path": "ust_29",
   "text": "Biernacki Jacek Mirosław, 30. Dallmann Krzysztof Wacław, 31. Górski Ireneusz Rafał, 32. Kania Krzysztof, 33. Krasuski Adam Zbigniew, 34. Pachecki Sławomir, 35. Rytel Józef Wiktor, 36. Sztajnert Maciej Artur, 37. Zych Andrzej Marek,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "38",
   "path": "ust_38",
   "text": "Biernacka Agata Jadwiga, 39. Cegliński Arkadiusz, 40. Choiński Sławomir, 41. Ciecierska Małgorzata Zofia, 42. Furtacz Michał Tomasz, 43. Gmaj Dariusz Ireneusz, 44. Godlewski Michał, 45. Prasek Bożena Franciszka, 46. Prasek Łukasz Artur, za zasługi w działalności na rzecz ochrony zdrowia:",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "47",
   "path": "ust_47",
   "text": "Jurkiewicz Beata,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "48",
   "path": "ust_48",
   "text": "Krajewska Danuta,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "49",
   "path": "ust_49",
   "text": "Szcześniak-Mazur Stanisława,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w odkrywaniu i popularyzowaniu prawdy historycznej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "50",
   "path": "ust_50",
   "text": "Zarębski Piotr Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "51",
   "path": "ust_51",
   "text": "Olewińska Grażyna Ewa,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "52",
   "path": "ust_52",
   "text": "Stachurski Leszek,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "53",
   "path": "ust_53",
   "text": "Kowalczyk Tadeusz, 54. Kręcisz Jadwiga,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "55",
   "path": "ust_55",
   "text": "Kelman Piotr,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w dokumentowaniu i popularyzowaniu tradycji oraz historii komunikacji szynowej w Polsce"
    }
   ]
  },
  {
   "type": "ust",
   "num": "56",
   "path": "ust_56",
   "text": "Walczak Dariusz Eugeniusz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podkarpackiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "57",
   "path": "ust_57",
   "text": "Wójciak Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "58",
   "path": "ust_58",
   "text": "Ochał Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "59",
   "path": "ust_59",
   "text": "Miąso Ludwika, 60. Saj Józef, 61. Skałuba Stanisław, za zasługi w działalności społecznej na rzecz Stowarzyszenia Certyfikowanych Audytorów i Specjalistów do spraw Kontroli Wewnętrznej",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "62",
   "path": "ust_62",
   "text": "Hady-Głowiak Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Wielkopolskiego"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej oraz związkowej na rzecz ochrony zdrowia:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "63",
   "path": "ust_63",
   "text": "Berlińska Alicja, 64. Mocek Marzena,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz terapii osób uzależnionych"
    }
   ]
  },
  {
   "type": "ust",
   "num": "65",
   "path": "ust_65",
   "text": "Frydryszak Wiesława,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz ochrony zdrowia:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "66",
   "path": "ust_66",
   "text": "Grys Ewa, 67. Żurek Beata Maria,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz propagowania turystyki i krajoznawstwa"
    }
   ]
  },
  {
   "type": "ust",
   "num": "68",
   "path": "ust_68",
   "text": "Szukała Romuald Maria,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Zachodniopomorskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju medycyny i ochrony zdrowia"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "69",
   "path": "ust_69",
   "text": "Majkowska Lilianna Zofia, 70. Walecka Anna Teresa, 71. Zdziarska Barbara Maria, 72. Żyluk Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz upamiętniania wydarzeń historycznych"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "73",
   "path": "ust_73",
   "text": "Kaźmierski Piotr Tomasz.",
   "children": []
  },
