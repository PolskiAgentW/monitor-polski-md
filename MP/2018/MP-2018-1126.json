{
 "eli": "MP/2018/1126",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 5 września 2018 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.7",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2018/1126/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 376/2018"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 5 września 2018 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2018 r. poz. 400, 730 i 1567) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za umacnianie suwerenności i obronności kraju:"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Paterek Marek Piotr,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Długosz-Błażkiewicz Anna Halina,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Adamusińska Agnieszka Karolina, 4. Cieślik Aneta Elżbieta,",
   "children": [
    {
     "type": "text",
     "text": "za dokonany w czasie służby czyn przynoszący szczególną korzyść Wojskom Lądowym, a wykraczający poza zwykły obowiązek"
    },
    {
     "type": "text",
     "text": "WOJSKOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Brzozowski Adam,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Pomorskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz związków zawodowych w Polsce:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Hellwig Iwona Beata,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Krużycka Iwona Barbara, 8. Pipczyński Ryszard.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
