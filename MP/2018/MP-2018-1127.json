  },
  {
   "type": "ust",
   "num": "35",
   "path": "ust_35",
   "text": "Krzykowski Ryszard Marek,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz upamiętniania historii Polski"
