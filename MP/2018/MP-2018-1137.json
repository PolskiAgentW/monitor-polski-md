{
 "eli": "MP/2018/1137",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 20 września 2018 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.7",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2018/1137/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 397/2018"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 20 września 2018 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2018 r. poz. 400, 730 i 1567) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Spraw Wewnętrznych i Administracji"
  },
  {
   "type": "text",
   "text": "za zasługi dla bezpieczeństwa państwa:"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Kubiak Marek,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Malesa Krzysztof Andrzej, 3. Świszcz Grzegorz Piotr,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Środowiska"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju leśnictwa"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Szczypiński Waldemar,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Lubuskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz osób potrzebujących pomocy oraz wsparcia, za propagowanie idei wolontariatu"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Lewandowski Marek,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podkarpackiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Stec Anna Halina.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
