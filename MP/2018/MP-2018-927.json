       ]
      },
      {
       "type": "ust",
       "num": "2",
       "path": "par_3/ust_2",
       "text": "Jednostki organizacyjne, o których mowa w ust. 1 pkt 1–18, w celu identyfikacji mogą posługiwać się wymiennie pełną nazwą albo ustalonym oznaczeniem cyfrowym, literowym lub cyfrowo-literowym.",
       "children": []
      },
      {
       "type": "ust",
       "num": "3",
       "path": "par_3/ust_3",
       "text": "W skład delegatur ABW mogą wchodzić wydziały zamiejscowe oraz samodzielne sekcje zamiejscowe.",
       "children": []
      },
      {
       "type": "ust",
       "num": "4",
       "path": "par_3/ust_4",
       "text": "Organizację wewnętrzną i szczegółowy zakres zadań jednostek organizacyjnych ABW określają regulaminy organizacyjne tych jednostek.",
       "children": []
      }
     ]
    },
    {
     "type": "par",
     "num": "4",
     "path": "par_4",
     "text": "Spory kompetencyjne między jednostkami organizacyjnymi ABW rozstrzyga Szef ABW.",
     "children": []
    },
    {
     "type": "par",
     "num": "5",
     "path": "par_5",
     "text": "Szef ABW może powoływać kolegialne organy doradcze i opiniodawcze, określając ich nazwę, skład osobowy oraz szczegółowy zakres i tryb działania.",
