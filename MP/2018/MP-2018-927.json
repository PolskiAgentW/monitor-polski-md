 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE NR 163"
  },
  {
   "type": "text",
   "text": "PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 26 września 2018 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Agencji Bezpieczeństwa Wewnętrznego"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 20 ust. 1 ustawy z dnia 24 maja 2002 r. o Agencji Bezpieczeństwa Wewnętrznego oraz Agencji Wywiadu (Dz. U. z 2017 r. poz. 1920, z późn. zm.[^1]) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Agencji Bezpieczeństwa Wewnętrznego nadaje się statut, który jest określony w załączniku do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 73 Prezesa Rady Ministrów z dnia 26 czerwca 2002 r. w sprawie nadania statutu Agencji Bezpieczeństwa Wewnętrznego (M.P. z 2018 r. poz. 279).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie po upływie miesiąca od dnia ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: M. Morawiecki"
  }
 ],
 "annexes": [
  {
   "heading": "Załącznik do zarządzenia nr 163 Prezesa Rady Ministrów z dnia 26 września 2018 r. (poz. 927)",
   "body": [
    {
     "type": "text",
     "text": "STATUT AGENCJI BEZPIECZEŃSTWA WEWNĘTRZNEGO"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Agencja Bezpieczeństwa Wewnętrznego, zwana dalej „ABW”, jest urzędem administracji rządowej obsługującym Szefa Agencji Bezpieczeństwa Wewnętrznego, zwanego dalej „Szefem ABW”, i działającym zgodnie z jego zarządzeniami, decyzjami, rozkazami, poleceniami i wytycznymi oraz pod jego bezpośrednim kierownictwem.",
     "children": []
    },
    {
     "type": "par",
     "num": "2",
     "path": "par_2",
     "text": "",
     "children": [
      {
       "type": "ust",
       "num": "1",
       "path": "par_2/ust_1",
       "text": "Szef ABW kieruje ABW przy pomocy zastępców oraz dyrektorów (kierowników) jednostek organizacyjnych, o których mowa w § 3.",
       "children": []
      },
      {
       "type": "ust",
       "num": "2",
       "path": "par_2/ust_2",
       "text": "Szefa ABW, w czasie jego nieobecności, zastępuje wyznaczony przez niego zastępca, działający w ramach udzielonych mu przez Szefa ABW pełnomocnictw.",
       "children": []
      },
      {
       "type": "ust",
       "num": "3",
       "path": "par_2/ust_3",
       "text": "Szef ABW może upoważnić osoby, o których mowa w ust. 1, oraz innych funkcjonariuszy ABW do podejmowania decyzji, w określonych sprawach, w jego imieniu.",
       "children": []
      }
     ]
    },
    {
     "type": "par",
     "num": "3",
     "path": "par_3",
     "text": "",
     "children": [
      {
       "type": "ust",
       "num": "1",
