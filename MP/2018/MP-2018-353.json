 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE NR REJ. 10/2018"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 19 stycznia 2018 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2015 r. poz. 475 i 1266, z 2016 r. poz. 1948, z 2017 r. poz. 2303 oraz z 2018 r. poz. 138) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Obrony Narodowej"
  },
  {
   "type": "text",
   "text": "za zasługi w ratowaniu życia ludzkiego:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM ZASŁUGI ZA DZIELNOŚĆ"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Danielak Zbigniew,",
   "children": [
    {
     "type": "text",
     "text": "MEDALEM ZA OFIARNOŚĆ I ODWAGĘ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "st. mar. Stach Grzegorz Jacek,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Spraw Wewnętrznych i Administracji"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego"
    },
    {
     "type": "text",
     "text": "KRZYŻEM ZASŁUGI ZA DZIELNOŚĆ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Kasperek Paweł Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Opolskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego"
    },
    {
     "type": "text",
     "text": "MEDALEM ZA OFIARNOŚĆ I ODWAGĘ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Gajda Dawid Józef, 5. Jabłoński Tomasz Przemysław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podkarpackiego"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego"
    },
    {
     "type": "text",
     "text": "MEDALEM ZA OFIARNOŚĆ I ODWAGĘ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Mierzwa Grzegorz, 7. Niemiec Tomasz Adam, 8. st. sierż. Śnios Piotr Jerzy, 9. Żbik Ryszard Franciszek,",
   "children": [
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Oko Zbigniew, na wniosek Wojewody Zachodniopomorskiego",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego"
    },
    {
     "type": "text",
     "text": "MEDALEM ZA OFIARNOŚĆ I ODWAGĘ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Nowicka Marlena.",
   "children": []
  },
  {
   "type": "signature",
