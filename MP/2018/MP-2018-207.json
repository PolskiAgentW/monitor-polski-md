    {
     "type": "text",
     "text": "STATUT MINISTERSTWA INWESTYCJI I ROZWOJU"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Inwestycji i Rozwoju, zwane dalej „Ministerstwem”, zapewnia obsługę Ministra Inwestycji i Rozwoju, zwanego dalej „Ministrem”, właściwego, na podstawie rozporządzenia Prezesa Rady Ministrów z dnia 10 stycznia 2018 r. w sprawie szczegółowego zakresu działania Ministra Inwestycji i Rozwoju (Dz. U. poz. 94 i 175), do spraw objętych działami:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/pkt_1",
       "text": "budownictwo, planowanie i zagospodarowanie przestrzenne oraz mieszkalnictwo;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/pkt_2",
       "text": "rozwój regionalny.",
       "children": []
      }
