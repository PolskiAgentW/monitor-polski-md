{
 "eli": "MP/2018/981",
 "title": "Obwieszczenie Ministra Finansów z dnia 11 października 2018 r. w sprawie listy państw uczestniczących objętych obowiązkiem raportowania za rok 2019",
 "converter": "eli2md 0.6.7",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2018/981/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "OBWIESZCZENIE"
  },
  {
   "type": "text",
   "text": "MINISTRA FINANSÓW[^1]"
  },
  {
   "type": "text",
   "text": "z dnia 11 października 2018 r."
  },
  {
   "type": "text",
   "text": "w sprawie listy państw uczestniczących objętych obowiązkiem raportowania za rok 2019"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 24 ust. 5 ustawy z dnia 9 marca 2017 r. o wymianie informacji podatkowych z innymi państwami (Dz. U. poz. 648 oraz z 2018 r. poz. 723 i 1499) ogłasza się listę państw uczestniczących, o których mowa w art. 24 ust. 1 pkt 25 lit. b i c tej ustawy, objętych obowiązkiem raportowania za rok 2019, stanowiącą załącznik do obwieszczenia."
  },
  {
   "type": "signature",
   "text": "Minister Finansów: wz. T. Robaczyński"
  }
 ],
