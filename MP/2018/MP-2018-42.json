{
 "eli": "MP/2018/42",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 11 października 2017 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.25",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2018/42/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 494/2017"
  },
  {
   "type": "text",
   "text": "Postanowienie"
  },
  {
   "type": "text",
   "text": "Prezydenta rzeczyPosPolitej Polskiej"
  },
  {
   "type": "text",
   "text": "z dnia 11 października 2017 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2015 r. poz. 475 i 1266 oraz z 2016 r. poz. 1948) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Edukacji Narodowej"
  },
  {
   "type": "text",
   "text": "za zasługi w działalności na rzecz rozwoju oświaty"
  },
  {
   "type": "text",
   "text": "SREBRNYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Sepko-Guzicka Elżbieta Aniela,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Infrastruktury i Budownictwa"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju transportu"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Przywoźny Jan, 3. Zawodny Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Kultury i Dziedzictwa Narodowego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony zabytków"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Dominik Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społeczno-kulturalnej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Trędowicz-Szal Bernadeta Beata,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Środowiska"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i ochrony leśnictwa"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Pązik Waldemar, na wniosek Ministra Zdrowia",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla ochrony zdrowia"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Nasierowska-Guttmejer Anna Maria,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Prezesa Polskiej Akademii Nauk"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju nauki:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Faryna Marek, 9. Morgiel Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Czeppe Tomasz, 11. Fima Przemysław, 12. Lipiński Marek, 13. Major Łukasz, 14. Major Roman, 15. Wojewoda-Budka Joanna,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Szefa Urzędu do Spraw Kombatantów i Osób Represjonowanych"
    },
    {
     "type": "text",
     "text": "za zasługi w upamiętnianiu historii Polski"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "16",
   "path": "ust_16",
   "text": "Bugajski Henryk,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Lubelskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "ks. Raboszuk Jan,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w upamiętnianiu historii Polski"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "18",
   "path": "ust_18",
   "text": "Wołek Karol,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Lubuskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania sportu"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Zmora Ireneusz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Łódzkiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz kultywowania narodowych tradycji i kształtowania postaw patriotycznych:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Anuszczyk Stefania, 21. Szewczyk Dariusz Wojciech,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "22",
   "path": "ust_22",
   "text": "Sikorska Elżbieta Maria, za zasługi w działalności na rzecz upowszechniania muzyki orkiestr dętych",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "23",
   "path": "ust_23",
   "text": "Foks Ireneusz Krzysztof, 24. Gradowski Piotr, 25. Machaj Robert Jacek, 26. Nowak Magdalena Anna, 27. Pokora Czesław Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Mazowieckiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz osób potrzebujących pomocy oraz wsparcia, zagrożonych wykluczeniem społecznym:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "po raz drugi"
    }
   ]
  },
  {
   "type": "ust",
   "num": "28",
   "path": "ust_28",
   "text": "Skowron Janusz Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "29",
   "path": "ust_29",
   "text": "Busłowicz Igor, 30. Planta Barbara Halina,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "Bałamut Michał, 32. Flaga Tomasz Jan, 33. Kaufman Jolanta Maria, 34. Kulik Krzysztof Zbigniew, 35. Kwapisz Jacek Maciej, 36. Mirowski Janusz Stanisław, 37. Nawankiewicz Ilona, 38. Rzepka Henryk Szczepan, 39. Sarota Sławomir Jerzy, 40. Tankielun Marek Arkadiusz, 41. Zielińska Marta,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podkarpackiego:"
    },
    {
     "type": "text",
     "text": "za wkład w rozwój kultury i sztuki, za osiągnięcia artystyczne"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "42",
   "path": "ust_42",
   "text": "Dudek Ryszard,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "43",
   "path": "ust_43",
   "text": "ks. Prucnal Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Śląskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania sportu szermierczego:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "44",
   "path": "ust_44",
   "text": "Chłosta Leszek Mieczysław,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "45",
   "path": "ust_45",
   "text": "Malcharczyk Anna Regina,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ratownictwa górskiego:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "46",
   "path": "ust_46",
   "text": "Gałuszka Ryszard, 47. Głowacki Ryszard Wojciech, 48. Król Przemysław Lech, 49. Łuszczak Edward Ludwik, 50. Nawrocki Paweł, 51. Radoń Bogdan, 52. Sadłek Wojciech, 53. Wantulok Stanisław, SREBRNYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "54",
   "path": "ust_54",
   "text": "Cieślar Bolesław, 55. ks. Cojda Krzysztof Adam, 56. Dyduch Henryk Krzysztof, 57. Fijak Artur Piotr, 58. Herzyk Jarosław Stanisław, 59. Konieczny Marek, 60. Kubala Dariusz, 61. Matusiak Jerzy Tadeusz, 62. Mizia Zygmunt Robert, 63. Tomczyk Tomasz,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "64",
   "path": "ust_64",
   "text": "Kurowski Ryszard, 65. Lach Włodzimierz, 66. Nowak Piotr, 67. Sapeta Szymon Bogumił, 68. Stanaszek Henryk Stanisław, 69. Stawarski Marek Lucjan,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ratownictwa górniczego:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "70",
   "path": "ust_70",
   "text": "Wieczorek Paweł,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "71",
   "path": "ust_71",
   "text": "Boratyński Adam, 72. Domowicz Artur Arkadiusz, 73. Gabzdyl Wojciech, 74. Wodniok Wojciech,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "75",
   "path": "ust_75",
   "text": "Cieślik Bożena Grażyna,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla budownictwa"
    }
   ]
  },
  {
   "type": "ust",
   "num": "76",
   "path": "ust_76",
   "text": "Dworska Ewa Maria,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "77",
   "path": "ust_77",
   "text": "Łukasik Damian Leszek, 78. Malisz Michał Maksymilian, 79. Olech Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz upowszechniania czytelnictwa"
    }
   ]
  },
  {
   "type": "ust",
   "num": "80",
   "path": "ust_80",
   "text": "Tkacz Ewa Maria,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Warmińsko-Mazurskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "81",
