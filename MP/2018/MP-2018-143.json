       "text": "gospodarka morska;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_1/pkt_2",
       "text": "gospodarka wodna;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
