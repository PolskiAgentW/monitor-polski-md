   "type": "text",
   "text": "Rej. 80/2018"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 15 marca 2018 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2018 r. poz. 400) za wybitne zasługi dla niepodległości Rzeczypospolitej Polskiej odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "text",
   "text": "pośmiertnie"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Malesiński Stanisław, 2. Stefanowski Władysław,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    },
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Burdyn Piotr, 4. Gołębiowski Eugeniusz, 5. Piekarski Marian, 6. Sadowski Jan, 7. Siedlecki Stanisław, 8. Wawiórko Edward,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Kulesza Jan,",
   "children": [
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Cudnowski Czesław Ignacy, 11. Kotarski Jan, 12. Wysocka Zofia, 13. Żabicka Leonarda.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
