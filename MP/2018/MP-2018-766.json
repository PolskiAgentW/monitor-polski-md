   "text": "Postanowienie nr rej. 195/2018"
  },
  {
   "type": "text",
   "text": "Prezydenta rzeczyPosPolitej Polskiej"
  },
  {
   "type": "text",
   "text": "z dnia 5 czerwca 2018 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2018 r. poz. 400 i 730) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Infrastruktury"
  },
  {
   "type": "text",
   "text": "za zasługi w ratowaniu mienia"
  },
  {
   "type": "text",
   "text": "MEDALEM ZA OFIARNOŚĆ I ODWAGĘ"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Kulka Bogusława Irena, 2. Urbańska Agnieszka,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Spraw Wewnętrznych i Administracji"
    },
    {
     "type": "text",
     "text": "za zasługi w ratowaniu życia ludzkiego"
    },
    {
     "type": "text",
     "text": "MEDALEM ZA OFIARNOŚĆ I ODWAGĘ"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Adamczyk Daniel Konrad, 4. Strózik Marcin Bogusław, 5. Ząbek Andrzej,",
