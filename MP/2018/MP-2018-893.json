{
 "eli": "MP/2018/893",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 12 lipca 2018 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.25",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2018/893/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 301/2018"
  },
  {
   "type": "text",
   "text": "Postanowienie"
  },
  {
   "type": "text",
   "text": "Prezydenta rzeczyPosPolitej Polskiej"
  },
  {
   "type": "text",
   "text": "z dnia 12 lipca 2018 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2018 r. poz. 400 i 730) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi dla niepodległości Rzeczypospolitej Polskiej:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Rossman Danuta Antonina,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Pawłowski Stanisław Kazimierz, 3. Prabucki Jan, 4. Ziemiańczuk Michał,",
   "children": [
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Langiewicz Stanisław Karol, 6. Motylonek Stefan, 7. Pyzowski Emil, 8. Wolski Henryk,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz zachowania tożsamości narodowej, za pracę duszpasterską"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    },
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "ks. Szczepański Jan,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla niepodległości Rzeczypospolitej Polskiej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Chuda Władysława,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Spraw Zagranicznych"
    },
    {
     "type": "text",
     "text": "obywatel Republiki Argentyńskiej"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi dla niepodległości Rzeczypospolitej Polskiej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Dąbrowski Władysław Jan, na wniosek Szefa Urzędu do Spraw Kombatantów i Osób Represjonowanych",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi dla niepodległości Rzeczypospolitej Polskiej, za pielęgnowanie pamięci o najnowszej historii Polski:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Besiński Edward, 13. Kuba Edward,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla niepodległości Rzeczypospolitej Polskiej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Plaskiewicz Helena Łucja,",
   "children": [
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Burak Edward.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
