{
 "eli": "MP/2018/1148",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 27 września 2018 r. o nadaniu orderów",
 "converter": "eli2md 0.6.7",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2018/1148/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 418/2018"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 27 września 2018 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2018 r. poz. 400, 730 i 1567) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności na rzecz rozwoju i upowszechniania archiwistyki:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KOMANDORSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Krawczak Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Basta Jan Witold, 3. Radziwonowicz Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności związkowej oraz na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Karuś Jan,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    },
    {
     "type": "text",
     "text": "za wybitne zasługi dla rozwoju nauk prawnych, za osiągnięcia w pracy naukowo-dydaktycznej oraz działalność publiczną"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Kłak Czesław Paweł,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w twórczości publicystycznej i pracy dziennikarskiej, za zasługi w działalności na rzecz przemian demokratycznych w Polsce"
    },
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Rybińska Krystyna.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
