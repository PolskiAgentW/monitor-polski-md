 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 16 września 2021 r."
  },
  {
   "type": "text",
   "text": "nr rej. 402/2021"
  },
  {
   "type": "text",
   "text": "o nadaniu orderów"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2020 r. poz. 138) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi dla przemian demokratycznych w Polsce, za osiągnięcia w podejmowanej z pożytkiem dla kraju pracy zawodowej oraz działalności na rzecz osób niepełnosprawnych"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Michałkiewicz Krzysztof Stefan,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz przemian demokratycznych w Polsce:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Goździk Henryk,",
   "children": []
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Sawicki Zbigniew Edward,",
   "children": [
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "ks. Galant Andrzej Jacek,",
   "children": []
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Jastrzębski Tomasz Ignacy,",
   "children": []
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Sawicka Krystyna Irena.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
