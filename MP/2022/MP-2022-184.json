 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 15 listopada 2021 r. nr rej. 503/2021 o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.25.2",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2022/184/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 15 listopada 2021 r."
  },
  {
   "type": "text",
   "text": "nr rej. 503/2021"
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2020 r. poz. 138), na wniosek Ministra Spraw Zagranicznych, odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "obywatelka Rzeczypospolitej Polskiej zamieszkała w Czarnogórze"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności polonijnej, za osiągnięcia w pracy artystycznej"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KAWALERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Peričić Marzena Bronisława,",
   "children": [
    {
     "type": "text",
     "text": "obywatelki Rzeczypospolitej Polskiej i Czarnogóry"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz środowisk polonijnych w Czarnogórze, za popularyzowanie polskiej kultury:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Medojević Teresa,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Kadović Halina Maria,",
   "children": []
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Knežević Bożena Regina,",
   "children": []
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Vujisić Ivona,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz środowisk polonijnych w Macedonii, za promowanie polskiej kultury"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ZASŁUGI RZECZYPOSPOLITEJ POLSKIEJ"
    },
    {
     "type": "text",
     "text": "obywatelki Rzeczypospolitej Polskiej i Republiki Macedonii Północnej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Maczkowska Maria Małgorzata,",
   "children": []
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Prokopowicz-Šaurek Teresa Kazimiera,",
   "children": []
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Samardżiska Zofia Krystyna,",
   "children": [
    {
     "type": "text",
     "text": "obywatel Republiki Macedonii Północnej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Samardżiski Jordan.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
