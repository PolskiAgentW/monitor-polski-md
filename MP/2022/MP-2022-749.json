   "text": "ZARZĄDZENIE NR 226"
  },
  {
   "type": "text",
   "text": "PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 29 lipca 2022 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Funduszy i Polityki Regionalnej"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2022 r. poz. 1188) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Funduszy i Polityki Regionalnej nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 266 Prezesa Rady Ministrów z dnia 16 grudnia 2019 r. w sprawie nadania statutu Ministerstwu Funduszy i Polityki Regionalnej (M.P. poz. 1187 oraz z 2021 r. poz. 743).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie z dniem następującym po dniu ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: M. Morawiecki"
  }
 ],
