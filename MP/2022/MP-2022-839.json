 "eli": "MP/2022/839",
 "title": "Obwieszczenie Ministra Finansów z dnia 4 sierpnia 2022 r. w sprawie ogłoszenia rejestru aktuariuszy",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2022/839/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "OBWIESZCZENIE"
  },
  {
   "type": "text",
   "text": "MINISTRA FINANSÓW[^1]"
  },
  {
   "type": "text",
   "text": "z dnia 4 sierpnia 2022 r."
  },
  {
   "type": "text",
   "text": "w sprawie ogłoszenia rejestru aktuariuszy"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 68 ust. 9 ustawy z dnia 11 września 2015 r. o działalności ubezpieczeniowej i reasekuracyjnej (Dz. U. z 2021 r. poz. 1130, 2140 i 2328 oraz z 2022 r. poz. 655 i 1488) ogłasza się rejestr aktuariuszy, według stanu na dzień 30 czerwca 2022 r., stanowiący załącznik do obwieszczenia."
  },
  {
   "type": "signature",
   "text": "Minister Finansów: M. Rzeczkowska"
  }
 ],
