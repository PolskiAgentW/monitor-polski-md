 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 10 sierpnia 2022 r."
  },
  {
   "type": "text",
   "text": "nr rej. 352/2022"
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2022 r. poz. 1031) za zasługi w ratowaniu życia ludzkiego odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "KRZYŻEM ZASŁUGI ZA DZIELNOŚĆ"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Spraw Wewnętrznych i Administracji:"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "sierż. Kuś Mateusz Piotr,",
   "children": []
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "sierż. Wieczorek Krzysztof Ryszard,",
   "children": [
    {
     "type": "text",
     "text": "MEDALEM ZA OFIARNOŚĆ I ODWAGĘ"
    },
    {
     "type": "text",
     "text": "na wniosek Ministra Obrony Narodowej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "st. chor. szt. mar. Leszczyński Sebastian,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Dolnośląskiego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Bury Mateusz,",
   "children": []
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Dubik Paweł Łukasz.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
