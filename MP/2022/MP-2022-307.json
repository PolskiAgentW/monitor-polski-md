   "text": "Wojewodzic Czesława,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI 27. Bukowiec Zofia,"
    }
   ]
  },
  {
   "type": "ust",
   "num": "28",
   "path": "ust_28",
   "text": "Karski Andrzej, BRĄZOWYM KRZYŻEM ZASŁUGI 29. Mazur Andrzej Karol,",
   "children": []
  },
  {
   "type": "ust",
   "num": "30",
   "path": "ust_30",
   "text": "Nazim Adam,",
   "children": []
  },
  {
   "type": "ust",
   "num": "31",
