    }
   ]
  },
  {
   "type": "ust",
   "num": "35",
   "path": "ust_35",
   "text": "Dziedzic-Dziędziel Grażyna,",
   "children": []
  },
  {
   "type": "ust",
   "num": "36",
   "path": "ust_36",
   "text": "Ptaszyński Przemysław Mariusz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz upowszechniania historii, tradycji i dziedzictwa regionalnego"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "37",
