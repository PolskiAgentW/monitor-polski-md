   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 26 maja 2022 r."
  },
  {
   "type": "text",
   "text": "nr 1130.46.2022"
  },
  {
   "type": "text",
   "text": "o powołaniu do pełnienia urzędu na stanowisku sędziego"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 179 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r., na wniosek Krajowej Rady Sądownictwa, powołuję niżej wymienione osoby do pełnienia urzędu:"
  },
  {
   "type": "text",
   "text": "na stanowisku sędziego Sądu Okręgowego:"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Monika Justyna Marzec – w Katowicach,",
   "children": []
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Łukasz Marcin Zamojski – w Gliwicach,",
   "children": [
    {
     "type": "text",
     "text": "na stanowisku sędziego Sądu Rejonowego:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Katarzyna Magdalena Bartoszewicz – w Sochaczewie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Tomasz Marek Domagała – w Głogowie,",
   "children": []
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Paulina Domańska – w Tomaszowie Mazowieckim,",
   "children": []
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Patrycja Agata Kosiorek – w Bytomiu.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
