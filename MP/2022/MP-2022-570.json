   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Miś Antoni Józef,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI 13. Bujnowski Krzysztof Zenon, na wniosek Wojewody Kujawsko-Pomorskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz ochrony przeciwpożarowej:"
