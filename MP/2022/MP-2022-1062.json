{
 "eli": "MP/2022/1062",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 22 sierpnia 2022 r. nr rej. 365/2022 o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.17",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2022/1062/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 22 sierpnia 2022 r."
  },
  {
   "type": "text",
   "text": "nr rej. 365/2022"
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2022 r. poz. 1031) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi w działalności publicznej, związkowej i społecznej na rzecz społeczności lokalnej"
  },
  {
   "type": "text",
   "text": "KRZYŻEM OFICERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Jankowski Maciej Władysław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz społeczności lokalnej, za upowszechnianie wiedzy na temat historii Polski"
    },
    {
     "type": "text",
     "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Laska Czesław,",
   "children": [
    {
     "type": "text",
     "text": "za wybitne zasługi w działalności na rzecz przemian demokratycznych w Polsce, za osiągnięcia w podejmowanej z pożytkiem dla kraju pracy społecznej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Jęcz Józef,",
   "children": []
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Sawicki Waldemar Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Lubuskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności związkowej i na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Grudzińska Elżbieta Mirosława,",
   "children": []
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Kępkowski Ryszard Edward,",
   "children": []
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Łabiak Janusz Stanisław,",
   "children": []
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Olszewska Danuta Maria.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
