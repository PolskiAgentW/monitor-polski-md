   "text": "ppłk Kling Arkadiusz,",
   "children": []
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "płk Kołomyjec Arkadiusz Dominik,",
   "children": []
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
