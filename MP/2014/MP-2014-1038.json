{
 "eli": "MP/2014/1038",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 27 sierpnia 2014 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.25",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2014/1038/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 407/2014"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 27 sierpnia 2014 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. Nr 90, poz. 450, z 1999 r. Nr 101, poz. 1177, z 2000 r. Nr 62, poz. 718, z 2002 r. Nr 74, poz. 676, z 2006 r. Nr 104, poz. 708 i 711 i Nr 194, poz. 1432, z 2007 r. Nr 25, poz. 162 i Nr 123, poz. 848, z 2009 r. Nr 168, poz. 1323, z 2010 r. Nr 155, poz. 1041 oraz z 2011 r. Nr 205, poz. 1207) odznaczeni zostają: na wniosek Ministra Kultury i Dziedzictwa Narodowego"
  },
  {
   "type": "text",
   "text": "za zasługi w utrwalaniu dóbr kultury i dziedzictwa narodowego, za działalność na rzecz rozwoju muzealnictwa:"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Garus Jerzy Krzysztof,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Szczecina-Berkan Anna Teresa, 3. Zalewska Irena,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Bębenek Agnieszka Katarzyna,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Łódzkiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Ptak Antoni,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podlaskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz upowszechniania kultury muzycznej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Sokołowski Leszek,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZY Ż EM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Puchalski Grzegorz, BRĄZOWYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Jakubowska-Puchalska Magdalena.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: B. Komorowski"
  }
 ],
 "annexes": [],
