   "body": [
    {
     "type": "text",
     "text": "STATUT MINISTERSTWA ADMINISTRACJI I CYFRYZACJI"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwo Administracji i Cyfryzacji, zwane dalej „ministerstwem”, zapewnia obsługę Ministra Administracji i Cyfryzacji, zwanego dalej „Ministrem”, właściwego, na podstawie rozporządzenia Prezesa Rady Ministrów z dnia 18 listopada 2011 r. w sprawie szczegółowego zakresu działania Ministra Administracji i Cyfryzacji (Dz. U. Nr 248, poz. 1479), do spraw:",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_1/pkt_1",
       "text": "administracji publicznej;",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
