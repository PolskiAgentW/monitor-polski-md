 "body": [
  {
   "type": "text",
   "text": "ZARZĄDZENIE NR 33"
  },
  {
   "type": "text",
   "text": "PREZESA RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 30 maja 2014 r."
  },
  {
   "type": "text",
   "text": "w sprawie nadania statutu Ministerstwu Środowiska"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2012 r. poz. 392) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ministerstwu Środowiska nadaje się statut, stanowiący załącznik do zarządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc zarządzenie nr 25 Prezesa Rady Ministrów z dnia 5 kwietnia 2012 r. w sprawie nadania statutu Ministerstwu Środowiska (M.P. poz. 202 oraz z 2013 r. poz. 380 i 561).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Zarządzenie wchodzi w życie z dniem następującym po dniu ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: D. Tusk"
  }
 ],
 "annexes": [
