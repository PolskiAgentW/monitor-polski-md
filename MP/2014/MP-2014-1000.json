     "text": "na wniosek Wojewody Lubelskiego"
    },
    {
     "type": "text",
     "text": "MEDALEM"
    },
    {
     "type": "text",
     "text": "ZA OFIARNO ŚĆ I ODWAG Ę"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
