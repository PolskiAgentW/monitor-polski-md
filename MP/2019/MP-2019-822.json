{
 "eli": "MP/2019/822",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 19 czerwca 2019 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.7",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2019/822/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 281/2019"
  },
  {
   "type": "text",
   "text": "Postanowienie"
  },
  {
   "type": "text",
   "text": "Prezydenta rzeczyPosPolitej Polskiej"
  },
  {
   "type": "text",
   "text": "z dnia 19 czerwca 2019 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2019 r. poz. 25, 730 i 992) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Wojewody Kujawsko-Pomorskiego:"
  },
  {
   "type": "text",
   "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej:"
  },
  {
   "type": "text",
   "text": "SREBRNYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Koszela Bogusław Eugeniusz,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Cichy Andrzej, 3. Cichy Bogusław, 4. Wątorowski Marian,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Czajkowska Adrianna Natalia, 6. Michułka-Kuraś Magdalena Maria, 7. Nowak Barbara, 8. Nowakowski Paweł Jacek, 9. Świtała Tomasz Adam,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz przeciwdziałania bezrobociu:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Jurek Małgorzata Aleksandra, 11. Tomkowiak Anna Barbara,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Łódzkiego"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz osób potrzebujących pomocy oraz wsparcia, zagrożonych wykluczeniem społecznym"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Fabrowska Anna Gabriela,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Laskowski Marian Wiktor, na wniosek Wojewody Małopolskiego:",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz osób potrzebujących pomocy oraz wsparcia, zagrożonych wykluczeniem społecznym, za promowanie idei wolontariatu:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Stefański Piotr Mikołaj,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Brojewska Alicja Teresa,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "16",
   "path": "ust_16",
   "text": "Godzwon Bartosz Łukasz, 17. Zięba Mirosław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania turystyki:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "18",
   "path": "ust_18",
   "text": "Sieja Lucyna Maria, 19. Stawiarski Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Cieślicki Paweł Tadeusz, 21. Wójcik Teresa Michalina,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "22",
   "path": "ust_22",
   "text": "Dacków Jerzy Władysław, 23. Popiela Alicja, 24. Surowiak Ewa, 25. Tomaszek Łucja Janina,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla rozwoju spółdzielczości:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "26",
   "path": "ust_26",
   "text": "Węgrzyniak Zofia Krystyna,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "27",
   "path": "ust_27",
   "text": "Bulka Anna Maria,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "28",
   "path": "ust_28",
   "text": "Rapacz Andrzej Piotr, 29. Rzepski Bolesław, 30. Skóra Józef, 31. Strojny Antoni Wojciech,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w popularyzacji sportów jeździeckich oraz promocji koni rasy huculskiej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "32",
   "path": "ust_32",
   "text": "Zygadło Tadeusz Jan,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Mazowieckiego:"
    },
    {
     "type": "text",
     "text": "za zasługi dla kultury polskiej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "33",
   "path": "ust_33",
   "text": "Łagowska Krystyna Teresa, za zasługi w kultywowaniu narodowych tradycji i kształtowaniu postaw patriotycznych",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "34",
   "path": "ust_34",
   "text": "Osiński Andrzej Kajetan,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podkarpackiego"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej, za wkład w rozwój i promowanie spółdzielczości:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "35",
   "path": "ust_35",
   "text": "Fedan Władysław, 36. Toborowicz Jan Antoni,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz dzieci potrzebujących pomocy oraz wsparcia, zagrożonych wykluczeniem społecznym"
    }
   ]
  },
  {
   "type": "ust",
   "num": "37",
   "path": "ust_37",
   "text": "Roga Anna Aniela,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podlaskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz propagowania specjalistycznej wiedzy z zakresu profilaktyki i ratownictwa wodnego"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "38",
   "path": "ust_38",
   "text": "Glińska Małgorzata Zofia, 39. Kobosko Katarzyna, 40. Leszczyński Tomasz, 41. Łucyk Paweł, 42. Olchowik Andrzej, 43. Roman Kamil Krzysztof, 44. Sokół Irena, 45. Wróblewski Piotr,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Śląskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej, za wkład w rozwój przedsiębiorczości"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "46",
   "path": "ust_46",
   "text": "Rosa Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Wielkopolskiego:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "47",
   "path": "ust_47",
   "text": "Borus Leszek Marian,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "48",
   "path": "ust_48",
   "text": "Woldański Jan,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania sportu"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "49",
   "path": "ust_49",
   "text": "Paczkowski Andrzej Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Zachodniopomorskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i charytatywnej na rzecz osób potrzebujących pomocy oraz wsparcia"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "50",
   "path": "ust_50",
   "text": "Kokłowski Józef, 51. Krawczyk Jerzy.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
