{
 "eli": "MP/2019/536",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 26 marca 2019 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.7",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2019/536/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 126/2019"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 26 marca 2019 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2019 r. poz. 25) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Kultury i Dziedzictwa Narodowego"
  },
  {
   "type": "text",
   "text": "za zasługi dla kultury polskiej:"
  },
  {
   "type": "text",
   "text": "SREBRNYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Kolaska Marceli Eugeniusz, 2. Reiner Roman,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Jabłoński Maciej, 4. Klocek Adam, 5. Lato Piotr,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Obrony Narodowej"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju medycyny i ochrony zdrowia"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Harat Marek Jan, 7. płk Siemiątkowski Mirosław Ferdynand,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Kujawsko-Pomorskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i oświatowej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Chrobak Dariusz,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Wasilewski Henryk,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju nauki i popularyzacji wiedzy naukowej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Macko Marek, 11. Muzyczuk Piotr Mirosław, za zasługi w działalności na rzecz ochrony przeciwpożarowej:",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Adamski Marek Janusz, 13. Bolewski Jacek, 14. Głuszak Edmund Wiesław, 15. Kiełkowski Krzysztof Stanisław, 16. Kostuch Sławomir Wojciech, 17. Kozłowski Tadeusz, 18. Kryszak Roman, 19. Orędowski Tomasz, 20. Szpakowski Bogdan, 21. Żuchowski Bogusław,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "22",
   "path": "ust_22",
   "text": "Bączkowski Waldemar Adam, 23. Czapliński Wojciech Jan, 24. Gaura Andrzej, 25. Głos Piotr, 26. Gołaś Grzegorz Rafał, 27. Matwiej Eugeniusz, 28. Szneidrowski Marek Mikołaj, 29. Tęgowski Tadeusz, 30. Żochowski Rafał,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przyrody oraz edukacji leśnej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "Balakowicz Maria Elżbieta,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "32",
   "path": "ust_32",
   "text": "Borowiak Tomasz Władysław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania pszczelarstwa"
    }
   ]
  },
  {
   "type": "ust",
   "num": "33",
   "path": "ust_33",
   "text": "Orciuch Maria Klara,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla kultury polskiej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "34",
   "path": "ust_34",
   "text": "Piekarski Mieczysław, 35. Putz Wojciech Antoni,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Lubelskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "36",
   "path": "ust_36",
   "text": "Kais Ryszard, 37. Świetlicki Tomasz Paweł,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Łódzkiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz edukacji przyrodniczo-leśnej i ochrony środowiska"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "38",
   "path": "ust_38",
   "text": "Anderwald Dariusz Henryk, 39. Banaszczak Piotr, 40. Wasilewski Grzegorz Tomasz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podkarpackiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej, za upowszechnianie historii Polski"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "41",
   "path": "ust_41",
   "text": "Szwedo Bogusław Aleksander,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "42",
   "path": "ust_42",
   "text": "Pasierb Jan Wojciech, na wniosek Wojewody Wielkopolskiego",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania pszczelarstwa"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "43",
   "path": "ust_43",
   "text": "Mrówka Maria Magdalena,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności edukacyjno-patriotycznej, za upowszechnianie historii Polski:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "44",
   "path": "ust_44",
   "text": "Bagrowska Izabela, 45. Łapuć Wojciech,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "46",
   "path": "ust_46",
   "text": "Maciejewska Helena, 47. Podskarbi Adam Witold.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
