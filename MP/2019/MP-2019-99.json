{
 "eli": "MP/2019/99",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 30 października 2018 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.25",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2019/99/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 502/2018"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 30 października 2018 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2018 r. poz. 400, 730 i 1567) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Obrony Narodowej"
  },
  {
   "type": "text",
   "text": "za zasługi dla obronności kraju"
  },
  {
   "type": "text",
   "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "płk Liberacki Marcin Maciej,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Sportu i Turystyki"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania żeglarstwa, za promowanie Polski w świecie"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Kuczyński Szymon Edmund,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Spraw Wewnętrznych i Administracji"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony zdrowia"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Suchorski Dariusz, 4. Sut Grzegorz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Głównego Lekarza Weterynarii"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony zdrowia publicznego"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Gwardjan Mariusz Stanisław, 6. Sułek Jarosław Grzegorz, 7. Szebla-Bartosińska Anita, 8. Uchański Artur Wiktor,",
   "children": []
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "Wyszkowski Wiesław Krzysztof,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podkarpackiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "ks. Machowicz Andrzej Władysław, 11. ks. Rusin Mieczysław, SREBRNYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Głodzik Zygmunt, 13. Kopała Adam Kazimierz, 14. Kudyba Jan, 15. Moryto Zdzisław, 16. Pater Marek Dariusz, 17. Siorek Kazimierz, 18. Toczyński Piotr Tomasz,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Baracz Stanisław, 20. Bechta Kazimierz, 21. Borowiec Stanisław Antoni, 22. Hamelusz Grzegorz, 23. ks. Hofman Marian, 24. ks. Jasiurkowski Józef, 25. Kiełt Tomasz, 26. Krupa Mieczysław, 27. Panek Wiesław Janusz, 28. Piotrowski Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz zachowania dziedzictwa kulturowego, za wkład w rozwój czytelnictwa"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "29",
   "path": "ust_29",
   "text": "Kozińska Maria Jolanta,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "30",
   "path": "ust_30",
   "text": "Misiura Józef Jerzy, 31. Ostafin Stanisław, 32. Strączek Wiesław Grzegorz, 33. Sułkowska Teresa, 34. Tabasz Władysław,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "35",
   "path": "ust_35",
   "text": "Czemarnik Wioletta Barbara,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "36",
   "path": "ust_36",
   "text": "Charchut Magdalena Zofia, 37. Rachwał Teresa Zofia,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz upamiętniania historii Polski"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "38",
   "path": "ust_38",
   "text": "ks. Rymarowicz Piotr Władysław,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w upamiętnianiu i upowszechnianiu historii Polski"
    }
   ]
  },
  {
   "type": "ust",
   "num": "39",
   "path": "ust_39",
   "text": "Puchalski Tadeusz Franciszek,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz zachowania dziedzictwa kulturowego"
    }
   ]
  },
  {
   "type": "ust",
   "num": "40",
   "path": "ust_40",
   "text": "ks. Zych Sławomir Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Śląskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej, charytatywnej i kulturalnej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "41",
   "path": "ust_41",
   "text": "Małysz Henryk,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "42",
   "path": "ust_42",
   "text": "Domider Tadeusz Zbigniew, za zasługi w działalności na rzecz ratownictwa górniczego:",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "43",
   "path": "ust_43",
   "text": "Golicz Piotr,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "44",
   "path": "ust_44",
   "text": "Kurtyka Paweł Michał,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "45",
   "path": "ust_45",
   "text": "Hanc Stefan Artur, 46. Niemiec Tomasz, 47. Wypior Jadwiga Urszula, 48. Wypior Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz dzieci i młodzieży"
    }
   ]
  },
  {
   "type": "ust",
   "num": "49",
   "path": "ust_49",
   "text": "Greń Irena,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "50",
   "path": "ust_50",
   "text": "Mankiewicz Piotr,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju górnictwa:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "51",
   "path": "ust_51",
   "text": "Orzech Łukasz Piotr, 52. Woszczyński Mariusz Łukasz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Świętokrzyskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz osób potrzebujących pomocy oraz wsparcia:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "53",
   "path": "ust_53",
   "text": "Milewska Agnieszka Monika,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "54",
   "path": "ust_54",
   "text": "Borek Edyta Iwona, 55. Kowalczyk Dorota, 56. Zięba Justyna Edyta,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Wielkopolskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju medycyny i ochrony zdrowia"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "57",
   "path": "ust_57",
   "text": "Skowronek Janusz Piotr,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i charytatywnej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "58",
   "path": "ust_58",
   "text": "Zaborski Robert Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "59",
   "path": "ust_59",
   "text": "Serdiuk Piotr Paweł,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "60",
   "path": "ust_60",
   "text": "Michalczak Idzi, na wniosek Wojewody Zachodniopomorskiego",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla kultury polskiej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "61",
   "path": "ust_61",
   "text": "Wilkońska Katarzyna Anna.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
