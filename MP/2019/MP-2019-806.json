{
 "eli": "MP/2019/806",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 7 czerwca 2019 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.25",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2019/806/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 258/2019"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 7 czerwca 2019 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2019 r. poz. 25, 730 i 992) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Środowiska"
  },
  {
   "type": "text",
   "text": "za zasługi w działalności na rzecz ochrony środowiska:"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Rymszewicz Wiesław,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Bojanowski Ireneusz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Głównego Lekarza Weterynarii"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony zdrowia publicznego i ochrony zdrowia zwierząt:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Długiewicz Andrzej Dorosław, 4. Szefliński Ireneusz, 5. Wielich Tomasz,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Dąbski Krzysztof, 7. Gotkowski Robert Eugeniusz, 8. Gruszewski Waldemar Franciszek, 9. Kokot-Ciszewska Joanna Katarzyna, 10. Kołyszko Henryk, 11. Marcinkowski Paweł Marian, 12. Misiek Elżbieta Małgorzata, 13. Piekarz Jerzy Ryszard, 14. Zakrzewski Tadeusz Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Lubuskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania sportu"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Piaskowski Marian Wacław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Łódzkiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "16",
   "path": "ust_16",
   "text": "Dębski Marian Józef, SREBRNYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Krzewiński Dariusz Adam,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "18",
   "path": "ust_18",
   "text": "Hoja Stanisław, 19. Jakóbiec Jan Kazimierz, 20. Kauc Krzysztof Jacek, 21. Łęgocki Kazimierz, 22. Pachulski Wojciech, 23. Skrobiszewski Marcin, 24. Spałka Jan Marian, 25. Świątek Sławomir Janusz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "26",
   "path": "ust_26",
   "text": "Warchoł Mariusz Adam,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "27",
   "path": "ust_27",
   "text": "Tokarczyk Jacek, 28. Wojewoda Dorota Justyna,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz pomocy dzieciom:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "29",
   "path": "ust_29",
   "text": "Chojnacki Wojciech Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "30",
   "path": "ust_30",
   "text": "Majewska Anna Dorota,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Małopolskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania sportu:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "Litwicki Wojciech Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "32",
   "path": "ust_32",
   "text": "Ludwig Piotr Rajmund,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "33",
   "path": "ust_33",
   "text": "Gosiewski Artur Grzegorz, 34. Wójcik Paweł Andrzej, 35. Zgierski Rafał Marcin,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i naukowej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "36",
   "path": "ust_36",
   "text": "Wieczorek Józef Franciszek,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz kultywowania narodowych tradycji i kształtowania postaw patriotycznych:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "37",
   "path": "ust_37",
   "text": "Czerwiński Janusz Marian,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "38",
   "path": "ust_38",
   "text": "Kołodziejczyk Krzysztof Robert, 39. Patyna Janusz Stanisław, 40. Węgrzyn Artur Marian, 41. Wojas Jakub Michał,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi dla kultury polskiej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "42",
   "path": "ust_42",
   "text": "Antkowiak Krzysztof Andrzej, 43. Brojek Dariusz Piotr, 44. Rembowski Leszek Marian, za zasługi w działalności na rzecz ochrony przeciwpożarowej",
   "children": []
  },
  {
   "type": "ust",
   "num": "45",
   "path": "ust_45",
   "text": "Twaróg Adam,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Mazowieckiego"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "46",
   "path": "ust_46",
   "text": "Murawski Artur,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i związkowej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "47",
   "path": "ust_47",
   "text": "Pietrzak Adam,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Świętokrzyskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz osób potrzebujących pomocy oraz wsparcia, zagrożonych wykluczeniem społecznym:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "48",
   "path": "ust_48",
   "text": "Mrugała Jolanta Małgorzata,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "49",
   "path": "ust_49",
   "text": "Jewiarz Agnieszka Cecylia, 50. Śmigielska Dorota Małgorzata.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
