{
 "eli": "MP/2019/520",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 12 marca 2019 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.25",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2019/520/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 104/2019"
  },
  {
   "type": "text",
   "text": "Postanowienie"
  },
  {
   "type": "text",
   "text": "Prezydenta rzeczyPosPolitej Polskiej"
  },
  {
   "type": "text",
   "text": "z dnia 12 marca 2019 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2019 r. poz. 25) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Wojewody Kujawsko-Pomorskiego:"
  },
  {
   "type": "text",
   "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej:"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Lipiński Antoni Roch,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Drapiewski Zdzisław, 3. ks. Koślicki Zbigniew Bogumił, 4. Matłosz Marek Michał, 5. Milewski Marcin, 6. Pankowski Rafał,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Bednarski Janusz, 8. Dwojacki Grzegorz Jerzy, 9. Karbowski Marek Krzysztof, 10. Manelski Marcin, 11. Olech Tadeusz, 12. Zych Bogdan Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w propagowaniu sportu i zdrowego stylu życia wśród młodzieży"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Szczepaniak Helena Krystyna,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podlaskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej na rzecz propagowania kultury i oświaty"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Kuźniewski Krzysztof, 15. Nowacka Jolanta, na wniosek Wojewody Zachodniopomorskiego",
   "children": [
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i duszpasterskiej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "16",
   "path": "ust_16",
   "text": "ks. Antkowiak Ireneusz Wacław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społeczno-kulturalnej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Matławski Bogdan,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności edukacyjno-wychowawczej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "18",
   "path": "ust_18",
   "text": "Plater-Zyberk Zofia Maria,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej oraz mniejszości romskiej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Trojanek Bogdan.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
