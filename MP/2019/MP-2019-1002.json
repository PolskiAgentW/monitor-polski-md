{
 "eli": "MP/2019/1002",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 29 sierpnia 2019 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.7",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2019/1002/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 430/2019"
  },
  {
   "type": "text",
   "text": "Postanowienie"
  },
  {
   "type": "text",
   "text": "Prezydenta rzeczyPosPolitej Polskiej"
  },
  {
   "type": "text",
   "text": "z dnia 29 sierpnia 2019 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2019 r. poz. 25, 730 i 992) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Kultury i Dziedzictwa Narodowego"
  },
  {
   "type": "text",
   "text": "za zasługi w pracy dziennikarskiej i radiowej, za osiągnięcia w działalności społecznej:"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Uzdańska-Leoniuk Elżbieta Stefania,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Chlasta Grzegorz, 3. Głogowska Aleksandra Urszula,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Całczyńska-Czuba Magdalena Maria, 5. Jakimiak Jolanta, 6. Teodorczuk Małgorzata Beata, 7. Wawrzyńska-Bąk Justyna Agnieszka,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Szefa Urzędu do Spraw Kombatantów i Osób Represjonowanych"
    },
    {
     "type": "text",
     "text": "za zasługi w upowszechnianiu wiedzy o najnowszej historii Polski"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "ks. Werra Zbigniew Józef,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Małopolskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i duszpasterskiej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "9",
   "path": "ust_9",
   "text": "ks. Kwiecień Bogdan Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Pomorskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Szczepański Marian Zygmunt, na wniosek Wojewody Świętokrzyskiego",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Błoński Janusz,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Bartczak Grzegorz Longin, 13. Smorąg Hubert Paweł, 14. Władymiruk Elżbieta Barbara,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Warmińsko-Mazurskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej, za wkład w rozwój ruchu uniwersytetów trzeciego wieku"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Orężak Iwona Małgorzata,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Wielkopolskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i związkowej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "16",
   "path": "ust_16",
   "text": "Dominiak Marek Ludwik,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Zachodniopomorskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Owczarek Marcin.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
