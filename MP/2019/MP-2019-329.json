{
 "eli": "MP/2019/329",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 26 lutego 2019 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.7",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2019/329/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 83/2019"
  },
  {
   "type": "text",
   "text": "Postanowienie"
  },
  {
   "type": "text",
   "text": "Prezydenta rzeczyPosPolitej Polskiej"
  },
  {
   "type": "text",
   "text": "z dnia 26 lutego 2019 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2019 r. poz. 25) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Nauki i Szkolnictwa Wyższego"
  },
  {
   "type": "text",
   "text": "za zasługi w działalności na rzecz rozwoju nauki:"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Alejski Krzysztof Tomasz, 2. Jaszkiewicz Andrzej, 3. Lipińska Anna Maria, 4. Styrcz-Przebinda Leokadia, 5. Szczuka-Dorna Liliana, 6. Szmyd Łukasz,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Frąckowiak Lech, 8. Fuć Paweł Grzegorz, 9. Gwiazda Aleksander Stanisław, 10. Kaczorek Ewa, 11. Krenz Rafał Jan, 12. Kręcisz Beata Maria, 13. Kucharska Ewa Halina, 14. Nadolny Zbigniew, 15. Szczepański Marek, 16. Wieczorowski Michał Adam, 17. Wróbel Dominik Krzysztof, 18. Zaforemska Halina,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Boczar Janusz, 20. Bonek Mirosław Sebastian, 21. Borowiec Arkadiusz Tomasz, 22. Dziubaszewska Renata Bernadeta, 23. Frączek Krzysztof, 24. Gawlak Agata Anna, 25. Gołąbek Bartosz Michał, 26. Grześkowiak Krzysztof, 27. Kulka Michał, 28. Milczarek Grzegorz, 29. Rogalski Wiesław Jan, 30. Siniecki Adam,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Dolnośląskiego"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "31",
   "path": "ust_31",
   "text": "Bednarek Bogdan Ryszard,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony zdrowia"
    }
   ]
  },
  {
   "type": "ust",
   "num": "32",
   "path": "ust_32",
   "text": "Koszela Małgorzata, na wniosek Wojewody Kujawsko-Pomorskiego",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "33",
   "path": "ust_33",
   "text": "Brzozowski Piotr, 34. Noske Marek,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "35",
   "path": "ust_35",
   "text": "Kaszuba Romuald, 36. Rajkowski Józef,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Lubelskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w popularyzowaniu wiedzy historycznej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "37",
   "path": "ust_37",
   "text": "Krawiec Henryk, 38. Marczak Lech Ryszard,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania sportu"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "39",
   "path": "ust_39",
   "text": "Kosierb Jacek Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Łódzkiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "40",
   "path": "ust_40",
   "text": "Supera Krzysztof,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "41",
   "path": "ust_41",
   "text": "Juszczak Tomasz, 42. Krawiec Sebastian,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Małopolskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ratownictwa wodnego"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "43",
   "path": "ust_43",
   "text": "Nocoń Karolina,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Śląskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju medycyny i ochrony zdrowia:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "44",
   "path": "ust_44",
   "text": "Rudzki Marek,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "45",
   "path": "ust_45",
   "text": "Pieniążek Tomasz,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i oświatowej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "46",
   "path": "ust_46",
   "text": "Hetman Anna, za zasługi w działalności społecznej:",
   "children": []
  },
  {
   "type": "ust",
   "num": "47",
   "path": "ust_47",
   "text": "Krzysztoń Maria Jadwiga, 48. Szczepaniak Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz osób potrzebujących pomocy oraz wsparcia, zagrożonych wykluczeniem społecznym"
    }
   ]
  },
  {
   "type": "ust",
   "num": "49",
   "path": "ust_49",
   "text": "Twardowska Beata Mariola,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Wielkopolskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "50",
   "path": "ust_50",
   "text": "Zaglaniczny Marian,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "51",
   "path": "ust_51",
   "text": "Bukowian Jacek, 52. Drobiński Zenon,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Zachodniopomorskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i samorządowej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "53",
   "path": "ust_53",
   "text": "Brzozowski Jerzy, 54. Jochemek Barbara, 55. Krakowska Jadwiga Teresa, 56. Ludwikowski Zdzisław, 57. Nowak Henryk, 58. Rysztak Teresa Zofia,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "59",
   "path": "ust_59",
   "text": "Pakos Daniel Mariusz.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
