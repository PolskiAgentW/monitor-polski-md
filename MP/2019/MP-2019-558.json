   "text": "Gembiak Wiesław Franciszek, 30. Mikstacki Paweł,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
