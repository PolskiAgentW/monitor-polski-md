    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Malendowski Marek,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Łódzkiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "21",
   "path": "ust_21",
   "text": "Florczak Jerzy Michał, 22. Kura Piotr Jan,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Śląskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania historii regionalnej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "23",
   "path": "ust_23",
   "text": "Biernacki Zbigniew Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "24",
   "path": "ust_24",
   "text": "Korzeniewski Arkadiusz Przemysław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania sportu"
    }
   ]
  },
  {
   "type": "ust",
   "num": "25",
   "path": "ust_25",
   "text": "Kwiatkowski Maciej Piotr,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Świętokrzyskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "26",
   "path": "ust_26",
   "text": "Marzec Ryszard Stanisław, 27. Wnuk Ernest Longin,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "28",
   "path": "ust_28",
   "text": "Osuch Błażej Daniel, na wniosek Wojewody Wielkopolskiego:",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju przedsiębiorczości:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "29",
