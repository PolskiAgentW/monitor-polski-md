 "body": [
  {
   "type": "text",
   "text": "Rej. 179/2019 POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 18 kwietnia 2019 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2019 r. poz. 25) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Inwestycji i Rozwoju"
  },
  {
   "type": "text",
   "text": "za zasługi w działalności na rzecz rozwoju przedsiębiorczości"
  },
  {
   "type": "text",
   "text": "SREBRNYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Kopyra Jacek Piotr,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Spraw Wewnętrznych i Administracji"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz bezpieczeństwa publicznego:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "nadinsp. Pobuta Krzysztof Mariusz,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "insp. Sowa Zbigniew Adam,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Czternastek Bogusław Jan,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Zdrowia"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju medycyny oraz ochrony zdrowia:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Stanisz Beata Jadwiga,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "6",
   "path": "ust_6",
   "text": "Jagodziński Paweł Piotr, 7. Kędzia Andrzej Włodzimierz, 8. Moczko Jerzy Andrzej, 9. Nowicki Michał Janusz, 10. Rębała Leszek Andrzej, 11. Surdacka Anna, na wniosek Wojewody Kujawsko-Pomorskiego",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Filipiak Paweł Wiesław, 13. Galij Antoni Kazimierz, 14. Jurek Jakub, 15. Kubicki Marek Antoni, 16. Pliszkowski Artur Michał, 17. Szablewski Krzysztof Jan, 18. Wachowiak Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Lubelskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony zdrowia"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "19",
   "path": "ust_19",
   "text": "Kędziora Waldemar Artur,",
   "children": [
    {
     "type": "text",
