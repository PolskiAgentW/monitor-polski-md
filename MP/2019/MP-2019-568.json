       "quoted": true
      },
      {
       "type": "text",
       "text": "18) Departament Społeczeństwa Obywatelskiego;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "19) Departament Spraw Obywatelskich;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "20) Departament Spraw Parlamentarnych;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "21) Departament Spraw Zagranicznych;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "22) Departament Studiów Strategicznych;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "23) Biuro Budżetowo-Finansowe;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "24) Biuro Dyrektora Generalnego;",
       "quoted": true
      },
      {
       "type": "text",
       "text": "25) Biuro Ochrony.”.",
       "quoted": true
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
