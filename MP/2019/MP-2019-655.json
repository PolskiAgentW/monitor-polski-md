{
 "eli": "MP/2019/655",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 28 maja 2019 r. o nadaniu orderów i odznaczeń",
 "converter": "eli2md 0.6.7",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2019/655/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 224/2019"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 28 maja 2019 r."
  },
  {
   "type": "text",
   "text": "o nadaniu orderów i odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2019 r. poz. 25, 730 i 992) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "za wybitne zasługi dla niepodległości Rzeczypospolitej Polskiej"
  },
  {
   "type": "text",
   "text": "KRZYŻEM KAWALERSKIM ORDERU ODRODZENIA POLSKI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Faszczewska Janina, 2. Palmowski Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Szefa Urzędu do Spraw Kombatantów i Osób Represjonowanych"
    },
    {
     "type": "text",
     "text": "za zasługi dla niepodległości Rzeczypospolitej Polskiej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "pośmiertnie"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Perkowski Mieczysław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w pielęgnowaniu pamięci o najnowszej historii Polski"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Wróblewski Jan Ignacy.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
