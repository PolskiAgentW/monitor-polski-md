   "text": "Kurowska Wiesława Barbara, 32. Marcińczak Krystyna Katarzyna, 33. Ochocka Elżbieta,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju spółdzielczości rolniczej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "34",
