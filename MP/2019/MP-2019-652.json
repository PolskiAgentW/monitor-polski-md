 "body": [
  {
   "type": "text",
   "text": "Rej. 220/2019 POSTANOWIENIE PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 22 maja 2019 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2019 r. poz. 25 i 730) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Gospodarki Morskiej i Żeglugi Śródlądowej za zasługi w popularyzowaniu chóralistyki i muzyki marynistycznej"
  },
  {
   "type": "text",
   "text": "SREBRNYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Fabiańczyk-Makuch Sylwia Oktawia,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Kultury i Dziedzictwa Narodowego za zasługi dla kultury polskiej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Minkiewicz Ryszard Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Karwaszewska Monika, 4. Rydel Paweł,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Rolnictwa i Rozwoju Wsi za zasługi w działalności społecznej, za wkład w rozwój polskiego rolnictwa:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Szczygieł Wacław Eugeniusz, 6. Sztoldman Małgorzata Anna,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Bobołowicz Włodzimierz Edward, 8. Okupniak-Stefańska Barbara, 9. Wrzosek Teresa Janina,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Spraw Wewnętrznych i Administracji za zasługi w działalności na rzecz samorządu pielęgniarek i położnych"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "10",
   "path": "ust_10",
   "text": "Mieszkowska Elżbieta Maria, na wniosek Ministra Środowiska",
   "children": [
    {
     "type": "text",
     "text": "za zasługi na rzecz leśnictwa w Polsce"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Konieczny Andrzej Antoni,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Dolnośląskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi na rzecz rozwoju pszczelarstwa"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Dawidowicz Eugeniusz Seweryn,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju turystyki:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "Zając-Klińska Janina Zofia,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "14",
   "path": "ust_14",
   "text": "Kublik Iwona Anna,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "15",
   "path": "ust_15",
   "text": "Żelichowski Mariusz Jacek,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i związkowej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "16",
   "path": "ust_16",
   "text": "Zarzycki Mariusz Zbigniew,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "17",
   "path": "ust_17",
   "text": "Bednarek Andrzej Jan, 18. Kasprowicz Roman Józef, 19. Sondaj Leszek Józef,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania sportu"
    }
   ]
  },
  {
   "type": "ust",
   "num": "20",
   "path": "ust_20",
   "text": "Piepiora Paweł Adam,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Kujawsko-Pomorskiego:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju nauki"
    }
   ]
  },
  {
   "type": "ust",
   "num": "21",
   "path": "ust_21",
   "text": "Bieliński Kazimierz Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju transportu:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "22",
   "path": "ust_22",
   "text": "Cader Mirosław Wincenty, 23. Grzelak Tadeusz, 24. Niedbalski Edward Hieronim, 25. Rogowski Roman, 26. Szczęsny Zbigniew,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności charytatywnej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "27",
   "path": "ust_27",
   "text": "Rutkowski Janusz Stanisław, na wniosek Wojewody Lubelskiego:",
   "children": [
    {
     "type": "text",
     "text": "za zasługi na rzecz ochrony zdrowia publicznego"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "28",
   "path": "ust_28",
   "text": "Kyc Elżbieta,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "29",
   "path": "ust_29",
   "text": "Duwer Eugeniusz Paweł,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Lubuskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "30",
   "path": "ust_30",
   "text": "Szeląg Agnieszka Joanna,",
   "children": [
