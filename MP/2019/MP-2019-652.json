   "text": "Litwińska Teresa Józefa,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju turystyki"
    }
   ]
  },
  {
   "type": "ust",
   "num": "37",
   "path": "ust_37",
   "text": "Smajdor Zbigniew,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony przeciwpożarowej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "38",
   "path": "ust_38",
   "text": "Curlej Michał Jacek, 39. Handzlik Mariusz Edward, 40. Momot Jerzy, 41. Sobecki Marian, 42. Tyran Tomasz Paweł, 43. Wiśniowski Władysław,",
   "children": [
