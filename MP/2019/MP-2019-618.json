    {
     "type": "text",
     "text": "z dnia 14 lutego 2018 r."
    },
    {
     "type": "text",
     "text": "w sprawie nadania statutu Ministerstwu Inwestycji i Rozwoju"
    },
    {
     "type": "text",
     "text": "Na podstawie art. 39 ust. 5 ustawy z dnia 8 sierpnia 1996 r. o Radzie Ministrów (Dz. U. z 2019 r. poz. 1171) zarządza się, co następuje:"
    },
    {
     "type": "par",
     "num": "1",
     "path": "par_1",
     "text": "Ministerstwu Inwestycji i Rozwoju nadaje się statut, stanowiący załącznik do zarządzenia.",
     "children": []
    },
    {
     "type": "par",
     "num": "2",
     "path": "par_2",
     "text": "Zarządzenie wchodzi w życie z dniem następującym po dniu ogłoszenia[^1].",
     "children": []
    }
   ]
  },
