 "eli": "MP/2019/821",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 19 czerwca 2019 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.25",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2019/821/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 280/2019"
  },
  {
   "type": "text",
   "text": "Postanowienie"
  },
  {
   "type": "text",
   "text": "Prezydenta rzeczyPosPolitej Polskiej"
  },
  {
   "type": "text",
   "text": "z dnia 19 czerwca 2019 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2019 r. poz. 25, 730 i 992) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Zdrowia"
  },
  {
   "type": "text",
   "text": "za zasługi w działalności na rzecz społeczności lokalnej"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Adamejt Jerzy,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Pomorskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju i upowszechniania pszczelarstwa"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Toporkiewicz Ewa Katarzyna,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Świętokrzyskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i duszpasterskiej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "ks. Pindera Stanisław Jan.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
