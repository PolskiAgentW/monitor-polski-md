{
 "eli": "MP/2019/509",
 "title": "Postanowienie Prezydenta Rzeczypospolitej Polskiej z dnia 7 marca 2019 r. o nadaniu odznaczeń",
 "converter": "eli2md 0.6.7",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/MP/2019/509/text.pdf",
 "body": [
  {
   "type": "text",
   "text": "Rej. 101/2019"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 7 marca 2019 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2019 r. poz. 25) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Obrony Narodowej"
  },
  {
   "type": "text",
   "text": "za zasługi dla obronności i suwerenności kraju, za wkład w rozwój szkolnictwa wojskowego"
  },
  {
   "type": "text",
   "text": "SREBRNYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "gen. bryg. Skorupka Dariusz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Małopolskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz społeczności lokalnej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Szczygieł Józef Stanisław,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w upamiętnianiu historii Polski:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "3",
   "path": "ust_3",
   "text": "Bracha Kamil Łukasz,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Dziubaniuk Katarzyna Jolanta,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "5",
   "path": "ust_5",
   "text": "Hebda Dariusz, 6. Kmieć Jarosław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Podkarpackiego:"
    },
    {
     "type": "text",
     "text": "za zasługi dla kultury polskiej, za osiągnięcia artystyczne"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Zaremba Beata, BRĄZOWYM KRZYŻEM ZASŁUGI",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz edukacji patriotycznej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "8",
   "path": "ust_8",
   "text": "Elgass Miłosz Radosław, 9. Feret Bartłomiej Filip, 10. Śliż Marek Antoni, 11. Trębacz Zbigniew Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i związkowej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "12",
   "path": "ust_12",
   "text": "Hyrczyk Robert Tomasz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i duszpasterskiej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "13",
   "path": "ust_13",
   "text": "o. Skupień Jacek Mariusz.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
 "annexes": [],
 "footnotes": {}
}
