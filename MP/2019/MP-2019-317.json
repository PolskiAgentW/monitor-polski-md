    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz odbudowy i rozwoju architektury sakralnej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
