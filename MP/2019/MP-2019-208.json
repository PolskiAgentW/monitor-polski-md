  {
   "type": "text",
   "text": "UCHWAŁA NR 16"
  },
  {
   "type": "text",
   "text": "RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 8 lutego 2019 r."
  },
  {
   "type": "text",
   "text": "w sprawie wyrażenia zgody na przekazanie Komisji Europejskiej dokumentu „Lista zmian granic obszarów Natura 2000”"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 27 ust. 3 ustawy z dnia 16 kwietnia 2004 r. o ochronie przyrody (Dz. U. z 2018 r. poz. 1614, 2244 i 2340) Rada Ministrów uchwala, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Rada Ministrów wyraża zgodę na przekazanie Komisji Europejskiej dokumentu „Lista zmian granic obszarów Natura 2000”, stanowiącego załącznik do uchwały.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Uchwała wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: M. Morawiecki"
  }
 ],
