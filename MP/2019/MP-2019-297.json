 "body": [
  {
   "type": "text",
   "text": "Rej. 17/2019"
  },
  {
   "type": "text",
   "text": "POSTANOWIENIE"
  },
  {
   "type": "text",
   "text": "PREZYDENTA RZECZYPOSPOLITEJ POLSKIEJ"
  },
  {
   "type": "text",
   "text": "z dnia 15 stycznia 2019 r."
  },
  {
   "type": "text",
   "text": "o nadaniu odznaczeń"
  },
  {
   "type": "text",
   "text": "Na podstawie art. 138 Konstytucji Rzeczypospolitej Polskiej z dnia 2 kwietnia 1997 r. oraz ustawy z dnia 16 października 1992 r. o orderach i odznaczeniach (Dz. U. z 2019 r. poz. 25) odznaczeni zostają:"
  },
  {
   "type": "text",
   "text": "na wniosek Ministra Inwestycji i Rozwoju"
  },
  {
   "type": "text",
   "text": "za zasługi w dziedzinie geodezji i kartografii:"
  },
  {
   "type": "text",
   "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
  },
  {
   "type": "ust",
   "num": "1",
   "path": "ust_1",
   "text": "Roszczypała Mirosław Andrzej,",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "2",
   "path": "ust_2",
   "text": "Bil Danuta Maria, 3. Olekszyk Feliks,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "4",
   "path": "ust_4",
   "text": "Kędziora Włodzimierz, 5. Średnicki Lucjan, 6. Tomasik Krzysztof,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Ministra Kultury i Dziedzictwa Narodowego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ochrony i konserwacji zasobów archiwalnych:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "7",
   "path": "ust_7",
   "text": "Jankowska Sylwestra Aleksandra, 8. Janowski Włodzimierz Marian, 9. Michalska-Ewiak Małgorzata, 10. Wojtasik Zbigniew,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "11",
   "path": "ust_11",
   "text": "Gąsior Renata Izabela, 12. Gębicka Dorota, 13. Gębicki Robert, 14. Kiliszek Katarzyna, 15. Kopycińska Izabela, 16. Kot Jacek, 17. Piliszek Elżbieta, 18. Przeździecka Małgorzata Maria, 19. Witkowski Michał, 20. Wojtkowska Barbara,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Dolnośląskiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej i duszpasterskiej:"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "21",
   "path": "ust_21",
   "text": "ks. Jurkiewicz Alfons, BRĄZOWYM KRZYŻEM ZASŁUGI",
   "children": []
  },
  {
   "type": "ust",
   "num": "22",
   "path": "ust_22",
   "text": "ks. Rybczyński Edward Marian,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju polskiej transplantologii"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "23",
   "path": "ust_23",
   "text": "Sędzimirska Mariola, 24. Szymczak Barbara,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi dla kultury polskiej:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "25",
   "path": "ust_25",
   "text": "Bybel Irena, 26. Hubiak Dioniza,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "27",
   "path": "ust_27",
   "text": "Peregrym Andrzej Piotr, 28. Starzyński Jerzy Piotr, 29. Gnaś-Romejko Zofia, 30. Jurczyk Paweł Tadeusz, 31. Porucznik Grzegorz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz ratownictwa medycznego"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "32",
   "path": "ust_32",
   "text": "Grądek Artur,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju medycyny i ochrony zdrowia:"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "33",
   "path": "ust_33",
   "text": "Kosińska Maria,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "34",
   "path": "ust_34",
   "text": "Wybieralska-Chalimoniuk Grażyna,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w upamiętnianiu historii Polski:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "35",
   "path": "ust_35",
   "text": "Chandoha Roman, 36. Młodzik Piotr,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz rozwoju transportu oraz bezpieczeństwa ruchu drogowego"
    }
   ]
  },
  {
   "type": "ust",
   "num": "37",
   "path": "ust_37",
   "text": "Rakoczy Zygmunt Grzegorz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Łódzkiego"
    },
    {
     "type": "text",
     "text": "za zasługi dla kultury polskiej"
    },
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "38",
   "path": "ust_38",
   "text": "Kowalski Wiesław,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Mazowieckiego:"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności naukowej i dydaktycznej"
    },
    {
     "type": "text",
     "text": "ZŁOTYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "39",
   "path": "ust_39",
   "text": "Brociek Wiesław Lech, za zasługi w działalności na rzecz osób potrzebujących pomocy oraz wsparcia, zagrożonych wykluczeniem społecznym",
   "children": [
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "40",
   "path": "ust_40",
   "text": "Pipka Eleonora,",
   "children": [
    {
     "type": "text",
     "text": "BRĄZOWYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w kultywowaniu i kontynuowaniu tradycji kawalerii i jazdy konnej:"
    }
   ]
  },
  {
   "type": "ust",
   "num": "41",
   "path": "ust_41",
   "text": "Dziełak Wojciech, 42. Michalik Arkadiusz,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "43",
   "path": "ust_43",
   "text": "Zalewski Paweł Grzegorz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Pomorskiego"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności społecznej"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    }
   ]
  },
  {
   "type": "ust",
   "num": "44",
   "path": "ust_44",
   "text": "Wójcik Tadeusz,",
   "children": [
    {
     "type": "text",
     "text": "na wniosek Wojewody Wielkopolskiego"
    },
    {
     "type": "text",
     "text": "SREBRNYM KRZYŻEM ZASŁUGI"
    },
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz honorowego krwiodawstwa, za propagowanie idei czerwonokrzyskiej"
    }
   ]
  },
  {
   "type": "ust",
   "num": "45",
   "path": "ust_45",
   "text": "Michalczak Dorota,",
   "children": [
    {
     "type": "text",
     "text": "za zasługi w działalności na rzecz osób potrzebujących pomocy oraz wsparcia, zagrożonych wykluczeniem społecznym"
    }
   ]
  },
  {
   "type": "ust",
   "num": "46",
   "path": "ust_46",
   "text": "Wierzbicki Marian Andrzej.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezydent Rzeczypospolitej Polskiej: A. Duda"
  }
 ],
